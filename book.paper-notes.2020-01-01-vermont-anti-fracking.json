itical-Economy-of-Vermont-s-Anti-fracking.pdf?rlkey=vpf8i84sj0s3y4a66d3qsa8lb&dl=0","key":"A80dpJn8Qt"}],"key":"WsO4weFrks"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"W6WITWLTKH"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"TMcLttA0Ts"},{"type":"heading","depth":4,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"hyvd02vOU7"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"uAmtRmBS6b"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Vermont became first US state to ban hydraulic fracturing (Act 152, signed May 12, 2012) despite having zero known natural gas reserves.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"LrrYrsIQa9"}],"key":"zfPy4QGRcn"},{"type":"heading","depth":4,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"Gy7EgQU2Rf"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"NG8sgXsrYb"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Democratic Party affiliation and campaign donation levels were significantly related to voting to ban fracking. Median voter characteristics (poverty, education) showed effects in baseline models that disappeared in robustness checks. Results indicate legislator characteristics, not constituent preferences, primarily drive expressive voting.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"aljABf40N5"}],"key":"WLNfJctKG5"},{"type":"heading","depth":4,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"sTv7ssfdaS"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"kItKlCwCVc"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Vermont General Assembly voting on H.464/Act 152; 167 legislators (150 House, 30 Senate) from 2010-2012 term. Legislator data from VoteSmart (party, donations, education, birthplace). Median voter characteristics from 2010 American Community Survey at district level (80+ socioeconomic variables).","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"O79rV8XubX"}],"key":"M8zRZZwNq7"},{"type":"heading","depth":4,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"KKpmBvGS0D"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"BAuwqsj2OZ"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Double-selection post-LASSO methodology to handle high-dimensional confounders (3,320+ variables including interaction terms). Examined both legislator mechanism effects and median voter mechanism effects separately. Limited probability model with heteroscedasticity-robust standard errors.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"tmUe69iKXE"}],"key":"Q3vcWgPHHI"},{"type":"heading","depth":4,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"rW8z9mAtnn"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"QQaqT0uA76"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Vermont’s lack of known gas reserves makes this purely expressive voting context, limiting generalizability to instrumental policy decisions. Some median voter effects (poverty, retirement income) became insignificant in robustness checks with interaction terms. Findings specific to symbolic policy outcomes where economic factors may matter less.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"aQliEx3MwT"}],"key":"jpUnCkoBGD"},{"type":"heading","depth":4,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"LZ7J52HbyM"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"zIZ2EYEGWc"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/xoxrp260dapkl450x60an/The-Political-Economy-of-Vermont-s-Anti-fracking.pdf?rlkey=vpf8i84sj0s3y4a66d3qsa8lb&dl=0","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"ukaEUFAhf3"}],"urlSource":"https://www.dropbox.com/scl/fi/xoxrp260dapkl450x60an/The-Political-Economy-of-Vermont-s-Anti-fracking.pdf?rlkey=vpf8i84sj0s3y4a66d3qsa8lb&dl=0","key":"lVT6HjQ6RM"}],"key":"o7GLW3XnMH"},{"type":"heading","depth":3,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"pYx2YHV351"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"VTSdyYSQXF"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Expressive voting in federal systems has spillover consequences across jurisdictions. Understanding that symbolic policy decisions are driven primarily by legislator ideology and party rather than constituent demand has implications for how we interpret political representation, regulatory federalism, and the role of special interests in policymaking.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"VeDrt06PnS"}],"key":"Y0gaIfdWV7"}],"key":"TIBi33d23X"}],"key":"GA654xL0Wz"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Temporal actions under uncertainty in crowdfunding campaigns","short_title":"Crowdfunding and timing","url":"/book/paper-notes/2021-01-01-crowdfunding-temporal-actions","group":"Publications"},"next":{"title":"Political economy of Vermont's abortion bill","short_title":"Vermont abortion bill","url":"/book/paper-notes/2020-01-01-vermont-abortion-bill","group":"Publications"}}},"domain":"http://localhost:3000"}