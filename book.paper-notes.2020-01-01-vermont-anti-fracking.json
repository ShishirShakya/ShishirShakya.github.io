{"version":3,"kind":"Article","sha256":"d1a36145a650045819f75742779a408a8582d3ec8db921772b1fa1405fb18e39","slug":"book.paper-notes.2020-01-01-vermont-anti-fracking","location":"/book/paper-notes/2020-01-01-vermont-anti-fracking.md","dependencies":[],"frontmatter":{"title":"Political economy of Vermont's anti-fracking movement","description":"Legislative voting on Vermont's fracking ban was driven primarily by legislator ideology and party affiliation, not constituent demand or regional economic factors.","short_title":"Vermont anti-fracking","tags":["policy","political-economy","energy"],"date":"2020-01-01","copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2020-01-01-vermont-anti-fracking.md","url":"/build/2020-01-01-vermont-a-86114ef740be728a1c868ad164184364.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Political economy of Vermont’s anti-fracking movement","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"KfRPM9KgMq"}],"identifier":"political-economy-of-vermonts-anti-fracking-movement","label":"Political economy of Vermont’s anti-fracking movement","html_id":"political-economy-of-vermonts-anti-fracking-movement","implicit":true,"key":"AxwmD0WNw2"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"lMmktm4PTt"}],"key":"nXPYNKx2kB"},{"type":"text","value":": ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"YXBkQKfCYc"},{"type":"inlineCode","value":"hall-2020-vermont-anti-fracking","position":{"start":{"line":14,"column":1},"end":{"lin