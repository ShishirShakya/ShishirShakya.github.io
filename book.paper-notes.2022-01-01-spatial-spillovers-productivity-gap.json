bel":"Facts","html_id":"facts","implicit":true,"key":"s6QQgZwSwZ"},{"type":"heading","depth":3,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"AkoI9Nnps9"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"ikwAaAf43P"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"The U.S. productivity-compensation gap has puzzled economists since the 1970s. Do productivity gains fail to translate to wages because spillovers to neighboring regions mean workers capture only partial benefits?","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"e0aQaxXQi3"}],"key":"YgazE0jktz"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"HQfo9zuHXa"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"ZSOUpNMNw3"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Accounting for productivity spillovers across state boundaries significantly narrows the productivity-compensation gap, suggesting regional spillovers explain meaningful portions of wage stagnation.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"C4RMwlswcM"}],"key":"bo3LHabLpw"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"AD8iCSDYXa"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"PqCizHr0hW"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"State-level industry panel data for 66 industries across 48 continental U.S. states, 1998-2017, including employment, compensation, and gross industrial output.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"S7Cg9P98Ym"}],"key":"cVcOPkTvKr"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"XWUB3myEhn"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"izoZDnNqPI"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Spatial econometric techniques including spatial two-stage least squares instrumental variables and spatially lagged X framework model how productivity in one state affects neighboring state compensation.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"zceDOjPivD"}],"key":"loUdxFZrcr"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"xbMa5LMshZ"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"ajrl8QpiVq"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"State-level geographic unit may be too broad to capture important metro-level or local spillovers within state boundaries.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"VHMRIdYZwi"}],"key":"kTlUbr9QsP"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"XcDljNpaWD"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"XOC5VBDbYe"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/tf99i7zifoqrx9zyyybpj/Spatial-Spillovers-and-the-Productivity-Compensation.pdf?rlkey=kklhwmtat547j88dp7ghz4xwx&dl=0","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"F30nJpy6UG"}],"urlSource":"https://www.dropbox.com/scl/fi/tf99i7zifoqrx9zyyybpj/Spatial-Spillovers-and-the-Productivity-Compensation.pdf?rlkey=kklhwmtat547j88dp7ghz4xwx&dl=0","key":"hlfGegoKfe"}],"key":"VdboE79rXz"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"wu3uhyMg5E"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"LXCG1p54WS"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"The productivity-compensation gap is a major inequality story: workers produce more value but don’t earn more. One explanation is that productivity gains flow to capital, not labor—but another is that they flow to other regions. This paper’s finding that regional spillovers explain part of the gap shifts the lens: wage stagnation may reflect globalization and supply-chain integration as much as corporate power. For labor advocates, the finding implies that local wage policy ignores regional dynamics—a worker in Ohio may lose wages because productivity gains spilled into Indiana. For economists, it highlights the importance of accounting for geographic interdependence in wage models. For policy, it suggests that regional wage coordination or redistribution mechanisms might be needed to ensure that productivity gains in spillover regions benefit the source region’s workers. The state-level focus also leaves open the possibility that metro-area and local spillovers are even more important.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"JjngflVU4b"}],"key":"AZHo84tXny"}],"key":"TYwY4q25TB"}],"key":"oTIQUYHCFJ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Nurse practitioner FPA, workforce diversity, and access","short_title":"NP FPA diversity and access","url":"/book/paper-notes/2022-06-01-np-fpa-diversity-access","group":"Publications"},"next":{"title":"Shale revolution, oil and gas prices, and drilling","short_title":"Shale revolution and drilling","url":"/book/paper-notes/2022-01-01-shale-revolution-drilling","group":"Publications"}}},"domain":"http://localhost:3000"}