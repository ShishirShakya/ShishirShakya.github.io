":21,"column":1}},"key":"p4xfiMBoBa"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"gQW7i0vWBW"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"How replicable is social and behavioral science research? Systematic assessment can identify which finding types replicate reliably and which warrant skepticism before policy application.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ySDl4sCAx6"}],"key":"khKl50bPnh"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"yfk6YvOxzW"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"qC8NSLXMgF"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Systematic replication study examining replicability of published findings across social and behavioral sciences identifies patterns in which result types successfully replicate.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"INoNhMZCOt"}],"key":"XiZ9OkSb30"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"p5HPOAWCxW"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"QrzrEcSdxd"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Large-scale replication study of social and behavioral science findings; Systematizing Confidence in Open Research and Evidence (SCORE) project in Nature publication.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"R2g7xxzTwE"}],"key":"xX932HaDm9"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"IUQPF52h4q"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"X8JQ821oYV"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Coordinated replication of many published studies using standardized protocols to measure what percentage of original findings successfully replicate.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"O6bi4FHZh0"}],"key":"RPORqyp5cY"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"aLToHk2Inz"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"XOuQoLW7eY"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Replication success depends on exact following the protocol and resource constraints may prevent perfect reproduction of original conditions.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"q1TohBKVvj"}],"key":"Gn3biVXZ7j"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"auav0UdhwS"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"CbrwfBlYmz"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://osf.io/preprints/metaarxiv/b7x8f","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"E4aGJmi7N9"}],"urlSource":"https://osf.io/preprints/metaarxiv/b7x8f","key":"UXrALZrmxw"}],"key":"nrv1VhURpO"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"TIhTbrjZLB"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"DUrLGtyYmy"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Science depends on cumulative knowledge, but cumulative knowledge is undermined if published findings don’t replicate. SCORE’s large-scale replication project is landmark work because it measures what percentage of social and behavioral science findings replicate with new data. If replication rates are high, the field is trustworthy; if low, policies built on social science are on shaky ground. For policy makers, the results inform how much confidence to place in social science evidence. For researchers, replication measures identify which finding types are strong versus fragile, directing future work toward understanding what makes results stable. The identification of patterns (which research areas replicate well, which don’t) is especially valuable - it guides researchers toward more reliable methods. For public trust in science, transparency about replication problems (and successes) builds credibility. The caveat that replication depends on following the protocol is important: negative results don’t always mean the original was wrong, but they do signal the need for caution before policy adoption. SCORE data provides a new gold standard for evidence quality assessment.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"zixXo0sWpZ"}],"key":"gKYRi8O1Ne"}],"key":"yHvbyIaDEa"}],"key":"Dj8cIw6CWG"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Investigating reproducibility in the social and behavioral sciences","short_title":"SCORE reproducibility","url":"/book/paper-notes/2026-01-01-score-reproducibility-nature","group":"Publications"},"next":{"title":"Hospital ownership and profits when a neighbor closes","short_title":"Hospital closure and profits","url":"/book/paper-notes/2026-01-01-hospital-closure-ownership-profits","group":"Publications"}}},"domain":"http://localhost:3000"}