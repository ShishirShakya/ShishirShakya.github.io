"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"kkBNKjtPvW"}],"key":"ySG2obrL5R"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"c4siK3AXXP"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"PVidzCDMJW"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Comparative analysis of covert regime change cases examining how ideological factors predict intervention outcomes and post-intervention governance quality.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"U9gY9NLWDM"}],"key":"tV5GbGC5La"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"gpVvdy42s3"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"oMkJ8TFEOA"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Historical case data on covert operations is incomplete and may reflect reporting bias, with success and outcome measurement subject to interpretation.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"XJtysvx9Fe"}],"key":"arWiC2xvhQ"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"bbw17nW4Ll"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"MYTN6Mx28H"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"cite","url":"https://link.springer.com/article/10.1007/s11127-026-01382-w","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Publisher page","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"VljXDnSx6I"}],"kind":"narrative","label":"Ammons_2026","identifier":"https://link.springer.com/article/10.1007/s11127-026-01382-w","enumerator":"1","key":"XzDypkt6Er"}],"key":"korj1FF4qy"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"k7qYMarkDf"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"w774x4X5Od"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Covert regime change—intervention disguised as internal rebellion—is a persistent tool of US foreign policy and other powers, yet systematic analysis of what determines success is rare. This paper examines whether ideology (ideological distance between intervener and target, or ideological coherence post-intervention) shapes outcomes. For foreign policy scholars, ideology is often dismissed as rhetoric masking material interests, but this paper treats it as a potentially causal variable. If true, it suggests that ideologically aligned coups may be more stable than regime-change operations imposed against local values. For policymakers, the finding implies that covert intervention outcomes depend not just on military/financial support but on ideological fit with the target population. For international relations theory, it bridges structural and ideational approaches: material capabilities matter, but ideas affect whether imposed regimes persist. The caveat (incomplete historical data) is significant—success and failure reporting biases underestimate failed coups—but comparative analysis within available data remains valuable for identifying patterns.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"IvTCC1GSzr"}],"key":"TDpZ6j9qpZ"}],"key":"GYTt4hDpiK"}],"key":"Uy6cJRtrNU"},"references":{"cite":{"order":["Ammons_2026"],"data":{"Ammons_2026":{"label":"Ammons_2026","enumerator":"1","doi":"10.1007/s11127-026-01382-w","html":"Ammons, J., Shakya, S., & Zhukov, K. (2026). Covert regime change and ideology. <i>Public Choice</i>. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1007/s11127-026-01382-w\">10.1007/s11127-026-01382-w</a>","url":"https://doi.org/10.1007/s11127-026-01382-w"}}}},"footer":{"navigation":{"prev":{"title":"Hospital ownership and profits when a neighbor closes","short_title":"Hospital closure and profits","url":"/book/paper-notes/2026-01-01-hospital-closure-ownership-profits","group":"Publications"},"next":{"title":"What do women gain from successful revolutions","short_title":"Women and revolution","url":"/book/paper-notes/2025-01-01-women-successful-revolution","group":"Publications"}}},"domain":"http://localhost:3000"}