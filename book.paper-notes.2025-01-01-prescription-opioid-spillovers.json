{"version":3,"kind":"Article","sha256":"ce85a6f8cb893ae37f78f7eb49a919e097210526292a1f435ff1f3a0abcdbb78","slug":"book.paper-notes.2025-01-01-prescription-opioid-spillovers","location":"/book/paper-notes/2025-01-01-prescription-opioid-spillovers.md","dependencies":[],"frontmatter":{"title":"Prescription opioid spillovers from retail pharmacies","description":"Must-access PDMP mandates reduce retail opioid sales within enacting states but generate cross-border spillover effects in neighboring voluntary PDMP states.","short_title":"Prescription opioid spillovers","tags":["substance-use","opioids","spillovers"],"date":"2025-01-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2025-01-01-prescription-opioid-spillovers.md","url":"/build/2025-01-01-prescript-d7da7c2038804906c6747f8f77aed9b0.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"TkbroZyIWs"}],"key":"bPXUn3Djuu"},{"type":"text","value":": ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"YHJbruHYRP"},{"type":"inlineCode","value":"hodges-2025-prescription-opioid-spillovers","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"iz2gJz0PLc"},{"type":"break","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"IRwlpWX9bF"},{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"OsTDpC47mf"}],"key":"NWVHhkSJZp"},{"type":"text","value":": verified","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"gQUspTak4J"}],"key":"T7Ry37R4GA"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"KOI1yxVv9I"}],"key":"C19NUULEmy"},{"type":"text","value":": Hodges, C. & Shakya, S. (2025). Prescription opioid spillovers: Retail pharmacy-level analysis. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"Gjdu5a5pOK"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Journal of Substance Use and Addiction Treatment","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"UschytEZ3L"}],"key":"hxBDv25qIs"},{"type":"text","value":", 175, 209725. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"BTRUDjyt56"},{"type":"cite","url":"https://doi.org/10.1016/j.josat.2025.209725","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"DOI","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"kAgpAjL44Q"}],"kind":"narrative","label":"Hodges_2025","identifier":"https://doi.org/10.1016/j.josat.2025.209725","enumerator":"1","key":"r4baRKct4T"},{"type":"text","value":". ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"hNipOa3EAD"},{"type":"link","url":"https://www.dropbox.com/scl/fi/sto4f3852u4mbzur56ih1/Prescription-opioid-spillovers_-Retail-pharmacy-level-analysis.pdf?rlkey=mb52o2583pgs17660hkd7d5ke&st=afw12tku&dl=0","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"VsSnHZrVQd"}],"urlSource":"https://www.dropbox.com/scl/fi/sto4f3852u4mbzur56ih1/Prescription-opioid-spillovers_-Retail-pharmacy-level-analysis.pdf?rlkey=mb52o2583pgs17660hkd7d5ke&st=afw12tku&dl=0","key":"g1BuEeYwYL"}],"key":"SbFlgCTTFO"},{"type":"heading","depth":2,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"cPtZwMRjmC"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"acrOuxOCIs"},{"type":"heading","depth":3,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"Ih1eXSAcpL"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"e07JYdcfYi"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Prescription drug monitoring programs (PDMPs) are state-level initiatives designed to curb opioid misuse. States vary in whether they mandate providers to consult the database before prescribing (“must-access”) or allow voluntary consultation. The question is whether must-access mandates reduce retail opioid sales and whether state-level policy variation generates unintended spillover effects in neighboring states with different PDMP structures.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"NPjhQ1tXA4"}],"key":"n3vpG9Y2Zj"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"smnsYWcNMZ"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"LaCEXdk04L"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Must-access PDMP implementation is associated with a decrease in retail opioid pills dispensed within enacting states. Pharmacies in must-access states show an average decline of 500-1,300 pills per month relative to voluntary PDMP states (depending on panel specification). Geographic spillover effects are present: must-access pharmacies close to voluntary PDMP state pharmacies show a larger decline (approximately 900 additional pills per month) than must-access pharmacies in interior locations. Effects persist across multiple distance specifications (10-35 miles).","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"qBlf0mhGfh"}],"key":"W2P8HpV6c1"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"ikMEtNPVV9"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"u0QPoH0q25"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Monthly pharmacy-level opioid sales from 2006-2014 covering 41,467 unique retail pharmacies in the contiguous United States and DC. Data encompasses all oxycodone and hydrocodone pills, patches, and lozenges shipped as part of each pharmacy transaction, sourced from DEA ARCOS database via Washington Post publication. Treatment states include West Virginia, Kentucky, New Mexico, Tennessee, New York, Indiana, Massachusetts, and Louisiana, which transitioned from voluntary to must-access PDMP structures at different times between 2012-2015.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"i0dRJzTAUz"}],"key":"xdwe1x0fMg"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"DMM3bfw1AK"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"e3sSZVxTie"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Generalized difference-in-differences design with pharmacy and time fixed effects comparing opioid sales in must-access versus voluntary PDMP states before and after policy implementation. Geographic spillover analysis examines whether must-access pharmacies within various distances (10-35 miles) of voluntary PDMP state pharmacies show different effects than interior must-access pharmacies. Event study framework examines dynamics before and after implementation. Analysis uses both unbalanced and balanced panel specifications, with conservative specification assigning zero sales to pharmacies with no recorded transactions.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"gGF2LcuXRV"}],"key":"Ou3j5uoEcc"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"c9NCXUbY76"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"qcQIeOPB24"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"No obvious conclusion regarding the one-year delay in observing effects; could reflect provider and patient adjustment time to new regulatory requirements. Cannot disentangle price versus quantity responses without individual transaction-level data. Relies on pharmacy designation as treatment unit, which may not capture all relevant geographic variation. Small sample sizes for some time periods (Indiana, Massachusetts, Louisiana had limited post-implementation data).","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"uZNYVunR07"}],"key":"kGEpF9MCs4"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ZmZAQc4qsN"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"L87qnC8yEb"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"cite","url":"https://doi.org/10.1016/j.josat.2025.209725","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"DOI: 10.1016/j.josat.2025.209725","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"dwamW0E9B5"}],"kind":"narrative","label":"Hodges_2025","identifier":"https://doi.org/10.1016/j.josat.2025.209725","enumerator":"1","key":"VRSlGuDwLK"},{"type":"text","value":". ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"zWZmMvqaTB"},{"type":"link","url":"https://www.dropbox.com/scl/fi/sto4f3852u4mbzur56ih1/Prescription-opioid-spillovers_-Retail-pharmacy-level-analysis.pdf?rlkey=mb52o2583pgs17660hkd7d5ke&st=afw12tku&dl=0","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"U3uEICCB4f"}],"urlSource":"https://www.dropbox.com/scl/fi/sto4f3852u4mbzur56ih1/Prescription-opioid-spillovers_-Retail-pharmacy-level-analysis.pdf?rlkey=mb52o2583pgs17660hkd7d5ke&st=afw12tku&dl=0","key":"Tg540pz2Z3"}],"key":"euTxifXFuJ"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"C9ZZsq7Hxm"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"rUUoLRR3cs"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"State-level policy variation in PDMP structures generates unintended cross-border consequences. Individuals in must-access states may travel to neighboring voluntary PDMP states to obtain opioid prescriptions, partly undoing the benefits of the state-level mandate. The larger decline in opioid sales at must-access pharmacies close to voluntary PDMP pharmacies is consistent with this cross-border substitution pattern. These findings highlight the need for interstate coordination in opioid policy. Policymakers should recognize that state-level mandates alone cannot address the opioid epidemic without complementary interstate data sharing and coordination, particularly in border regions.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"v2AThW2Lfb"}],"key":"ej7vRUmCUo"}],"key":"vbPc4m03rk"}],"key":"g0mjmMLQIb"},"references":{"cite":{"order":["Hodges_2025"],"data":{"Hodges_2025":{"label":"Hodges_2025","enumerator":"1","doi":"10.1016/j.josat.2025.209725","html":"Hodges, C. D., & Shakya, S. (2025). Prescription opioid spillovers: Retail pharmacy level analysis. <i>Journal of Substance Use and Addiction Treatment</i>, <i>175</i>, 209725. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1016/j.josat.2025.209725\">10.1016/j.josat.2025.209725</a>","url":"https://doi.org/10.1016/j.josat.2025.209725"}}}},"footer":{"navigation":{"prev":{"title":"Social movements and market legitimacy","short_title":"Market legitimacy of social movements","url":"/book/paper-notes/2025-01-01-social-movements-market-legitimacy","group":"Publications"},"next":{"title":"Scope-of-practice regulations and PA inter-state relocation","short_title":"PA scope of practice and relocation","url":"/book/paper-notes/2025-01-01-pa-scope-interstate-relocation","group":"Publications"}}},"domain":"http://localhost:3000"}