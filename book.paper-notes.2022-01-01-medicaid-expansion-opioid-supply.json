sition":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"w1LeXF3ljy"}],"key":"W1tC71z2R7"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"KY2NzIbQN1"}],"key":"DtxD9hqN3H"},{"type":"text","value":": Shakya, S., & Harrish, S. (2022). Medicaid expansion and opioid supply policies to address the opioid crisis. ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"ojEDU4mgvF"},{"type":"emphasis","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Drug and Alcohol Dependence Reports","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"i9r28xA3D4"}],"key":"sJTNmBHwGq"},{"type":"text","value":". ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"PskLz3HwH3"},{"type":"link","url":"https://www.dropbox.com/scl/fi/7m3j494m07g6dbt9ct1mt/Medicaid-expansion-and-opioid-supply-policies-to-address-the-opioid-overdose-crisis.pdf?rlkey=2s7ealv7uoxfikvteas8kbi3g&dl=0","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"SSiTFWKRFX"}],"urlSource":"https://www.dropbox.com/scl/fi/7m3j494m07g6dbt9ct1mt/Medicaid-expansion-and-opioid-supply-policies-to-address-the-opioid-overdose-crisis.pdf?rlkey=2s7ealv7uoxfikvteas8kbi3g&dl=0","key":"FRrhCzzEL5"}],"key":"jvjvtNC3q5"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"K4eJSlE4Io"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"oINl4wNTfi"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"KM8g7fRWF6"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"eDDfjg3pq4"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"The opioid crisis has a demand side (addiction, treatment access) and a supply side (overprescribing, drug availability). Policymakers use both: Medicaid expansion increases treatment access, while pain management clinic laws restrict oversupply. The question is whether these demand-side and supply-side policies work together, and which combination most effectively addresses opioid mortality.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"gDUAQl86Do"}],"key":"QsqSyp4tb3"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"BXxvPn1SX0"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"lpCLtkQ1fi"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Mix of Medicaid expansion and pain management clinic laws could balance limiting opioid prescription oversupply while improving access to opioid use disorder (OUD) treatment. States with both policies (Kentucky, Ohio, West Virginia, Louisiana) show potential for coordinated impact. Must-access PDMPs and pain management clinic laws are associated with reduced opioid prescribing and overdose deaths; Medicaid expansion increases buprenorphine availability for treatment.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"EdUJGZIBIO"}],"key":"OspHbV4oi4"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"Q2aEyYm6ZG"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"nPWEQ8sqO1"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"CDC data on retail opioid prescriptions dispensed per 100 persons (2006–2017) and buprenorphine distributions per 100,000 persons. Multiple states with varying pain management clinic law implementations (Louisiana 2006, Texas/Wisconsin 2009, Ohio/Mississippi/Kentucky/Florida 2011, Tennessee 2012, Georgia/Alabama 2013, West Virginia 2014). Four states enacted both Medicaid expansion and pain management clinic laws after 2014.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"YyRHxnFRiK"}],"key":"sCRHxJOXiY"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"adBjG3BEaF"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"g7KFTHD3Tp"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Difference-in-differences framework examining impacts of three treatment variables: (1) Medicaid expansion, (2) pain management clinic laws, (3) interaction of both. Dependent variables: retail opioid prescriptions per 100 persons and buprenorphine distributions per 100,000 persons. Controls for other opioid policies (must-access PDMPs, Good Samaritan laws, naloxone access) and socioeconomic variables (poverty, unemployment).","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"FAGdwQzcUt"}],"key":"mRqTKocjP5"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"cOFFrCfC4S"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"HwhQ3o94uL"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Complex interaction between demand-side and supply-side policies requires careful timing; confounding by multiple concurrent opioid-related policies makes isolating specific policy effects difficult. Buprenorphine distributions may not fully capture treatment access. Different implementation dates across states complicate causal attribution.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"YE99YYC7un"}],"key":"ednwNxkLC9"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"gg6sV8bP1D"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"hQexMhkfxh"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/7m3j494m07g6dbt9ct1mt/Medicaid-expansion-and-opioid-supply-policies-to-address-the-opioid-overdose-crisis.pdf?rlkey=2s7ealv7uoxfikvteas8kbi3g&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"fpPg7xibSX"}],"urlSource":"https://www.dropbox.com/scl/fi/7m3j494m07g6dbt9ct1mt/Medicaid-expansion-and-opioid-supply-policies-to-address-the-opioid-overdose-crisis.pdf?rlkey=2s7ealv7uoxfikvteas8kbi3g&dl=0","key":"dDkqI159TV"}],"key":"YF39LP8QCU"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"lDJQw9AONV"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"Rkd58J6t48"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"The opioid crisis requires both supply and demand solutions. This paper suggests they work best together. Pain management clinic laws alone restrict supply but may worsen inequality if they deny medication to patients with legitimate pain. Medicaid expansion alone increases treatment but doesn’t address overprescribing. The synergy—restricting inappropriate supply while expanding access to evidence-based treatment—offers a more balanced approach. For policymakers in high-overdose states, the finding supports comprehensive policy packages rather than betting on a single lever. For Southern and Appalachian states where both opioid prescribing and treatment gaps are severe, the paper provides evidence that coordinated demand-and-supply policies can address both sides of the crisis. The emphasis on policy complementarities also suggests that state-level variation in outcomes may reflect not which policies exist but how well they’re coordinated—a valuable insight for policy evaluation and state learning.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"C0NMQUnj4w"}],"key":"WUhzO09dm4"}],"key":"GpXiNkQLvE"}],"key":"VHwCIPAYg1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Must-access PDMPs and retail opioid sales","short_title":"Must-access PDMP and opioids","url":"/book/paper-notes/2022-01-01-must-access-pdmp-retail-opioids","group":"Publications"},"next":{"title":"The fracking boom and crime rates in rural American states","short_title":"Fracking and rural crime","url":"/book/paper-notes/2021-01-01-fracking-boom-rural-crime","group":"Publications"}}},"domain":"http://localhost:3000"}