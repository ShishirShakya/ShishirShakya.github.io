{"version":3,"kind":"Article","sha256":"9ff1fc049058246c1e9556351bd40ea7591030951b2cdf4a8447142e87833e1b","slug":"book.paper-notes.2025-01-01-pa-scope-interstate-relocation","location":"/book/paper-notes/2025-01-01-pa-scope-interstate-relocation.md","dependencies":[],"frontmatter":{"title":"Scope-of-practice regulations and PA inter-state relocation","description":"Optimal scope-of-practice laws increase PA interstate relocation by 3%; effect strongest in rural areas.","short_title":"PA scope of practice and relocation","tags":["scope-of-practice","healthcare","labor","workforce"],"date":"2025-01-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2025-01-01-pa-scope-interstate-relocation.md","url":"/build/2025-01-01-pa-scope--75e1393f736d36713b67ddb402885b0f.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"sRR60sIYHg"}],"key":"pH93d5DqNg"},{"type":"text","value":": ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"pq72GLLPcN"},{"type":"inlineCode","value":"nepal-2025-pa-scope-interstate","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"aJppt6189b"},{"type":"text","value":"\n","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"jw7Huuz5Rr"},{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"YjLkWM7wr5"}],"key":"rfgqRmp7g0"},{"type":"text","value":": verified","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"gnpNqQAsJj"}],"key":"sNwARYISVD"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"mQbjwBedZz"}],"key":"FsOdaYTsMY"},{"type":"text","value":": Nepal, T., & Shakya, S. (2025). Scope-of-Practice Regulations and Physician Assistant Inter-State Practice Relocation. ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"BjPyxnvCZq"},{"type":"emphasis","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Journal of Labor Research","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"NB1KzfLz8z"}],"key":"VG3Zpv7xDJ"},{"type":"text","value":". ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"poMijbuhLY"},{"type":"link","url":"https://www.dropbox.com/scl/fi/tqgnrk9fxrvznrlokdhmk/Shakya-Scope-of-Practice-Regulations-and-Physician-Assistant-Inter-State-Practice-Relocation.pdf?rlkey=usoy1gpnm952ocwktug0tcoac&st=ahe0oxz0&dl=0","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"EaVwe4J4XT"}],"urlSource":"https://www.dropbox.com/scl/fi/tqgnrk9fxrvznrlokdhmk/Shakya-Scope-of-Practice-Regulations-and-Physician-Assistant-Inter-State-Practice-Relocation.pdf?rlkey=usoy1gpnm952ocwktug0tcoac&st=ahe0oxz0&dl=0","key":"nXDEuIOcFS"}],"key":"V9pR2TwI0T"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"B7KBamtbWB"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"BqUuIw43RD"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"P51P9UFA0c"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"nmoPUCA8ot"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Physician assistants (PAs) face scope-of-practice restrictions that vary by state. Some states grant “optimal” scope-of-practice laws providing full practice authority and independent prescribing rights, while others maintain restrictive supervision requirements. The question is whether expanding PA autonomy influences their location decisions and improves workforce distribution, particularly in poorly served rural areas.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"jLXR12lbdL"}],"key":"ypfooroxlC"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ADH1lQqd0f"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"bocHI6xgep"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Physician assistants are approximately 3 percentage points more likely to relocate their practice to states with optimal scope-of-practice laws compared to restrictive states. More importantly, optimal scope-of-practice laws produce substantially larger retention effects in rural areas than non-rural areas, suggesting that practice autonomy is particularly valued by PAs considering rural practice locations.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"s8on4TgVU0"}],"key":"m3LwXAJwo5"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"xNT4P46g7H"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"WVXioXBSK0"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"National Plan and Provider Enumeration System (NPPES) database, 2016-2023, covering over one million physician assistants across all 50 US states. Five states enacted optimal scope-of-practice laws during the study period: North Dakota (2019), Utah and Wyoming (2021), and Iowa and Montana (2023). Analysis compares PAs’ interstate relocation patterns before and after these policy changes.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"srzJ3mAucd"}],"key":"ovgau0UmvQ"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"GJHpaZbJ2e"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"EuMCeCz43t"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Linear probability model applied to panel data tracking physician assistant practice locations from 2016-2023. Difference-in-differences framework exploits staggered adoption of optimal scope-of-practice laws across states. Group differences analysis separately examines rural and non-rural responses. Robustness checks include relaxing the optimal scope-of-practice definition and randomized inference tests to confirm statistical significance.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"oeELVYoQSW"}],"key":"NiD1hrm1QI"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"RDxXv3R5k2"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"T7GkYdPbHe"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The differential retention effect is substantially stronger in rural areas than non-rural areas, indicating that spatial context mediates policy impact. External validity to earlier time periods (before 2016) is unclear due to data availability. The analysis cannot determine whether higher relocation rates reflect PAs seeking expanded autonomy or whether other state-level factors correlate with both scope expansion and PA attraction.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"LkzIFTDvIT"}],"key":"Jz4XH32hkW"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"gTXNPYzvT8"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"N05dwOt7Al"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/tqgnrk9fxrvznrlokdhmk/Shakya-Scope-of-Practice-Regulations-and-Physician-Assistant-Inter-State-Practice-Relocation.pdf?rlkey=usoy1gpnm952ocwktug0tcoac&st=ahe0oxz0&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"t2SyiYJYuG"}],"urlSource":"https://www.dropbox.com/scl/fi/tqgnrk9fxrvznrlokdhmk/Shakya-Scope-of-Practice-Regulations-and-Physician-Assistant-Inter-State-Practice-Relocation.pdf?rlkey=usoy1gpnm952ocwktug0tcoac&st=ahe0oxz0&dl=0","key":"lM6wKIydfH"}],"key":"TYtPWpDual"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"wXbrHSd2QJ"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"VIlqjNyAuA"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Scope-of-practice restrictions are a major barrier to PA practice in the United States. This paper provides direct evidence that expanding PA autonomy influences relocation decisions - practitioners are more likely to practice in states that remove restrictive oversight requirements. Critically, the stronger rural effect suggests that practice autonomy is particularly valuable for addressing rural physician shortages. For policy makers considering scope expansion, the findings support a workforce-development rationale: removing restrictions doesn’t just allow existing PAs to practice more independently; it actually attracts PAs to practice in areas (rural regions) that desperately need them. The result matches with policy goals of improving geographic access to care. However, the effect size (3 percentage points) is modest, suggesting that scope expansion should be paired with other rural recruitment tools - loan forgiveness, housing subsidies, education pipeline development - to achieve substantial workforce redistribution.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"h4vqOGl9gr"}],"key":"zmqA2oRjFv"}],"key":"SsOX04TXRe"}],"key":"rGA8TlUS8i"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Prescription opioid spillovers from retail pharmacies","short_title":"Prescription opioid spillovers","url":"/book/paper-notes/2025-01-01-prescription-opioid-spillovers","group":"Publications"},"next":{"title":"Maternity care deserts in North Carolina","short_title":"Maternity care deserts NC","url":"/book/paper-notes/2025-01-01-maternity-care-deserts-nc","group":"Publications"}}},"domain":"http://localhost:3000"}