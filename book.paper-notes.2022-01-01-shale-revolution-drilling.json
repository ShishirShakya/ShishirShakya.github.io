{"version":3,"kind":"Article","sha256":"a5e633df63075a9dd9f859c11c63da46a22f760d9afaf274d9d082bfe52a77b6","slug":"book.paper-notes.2022-01-01-shale-revolution-drilling","location":"/book/paper-notes/2022-01-01-shale-revolution-drilling.md","dependencies":[],"frontmatter":{"title":"Shale revolution, oil and gas prices, and drilling","description":"Information spillover between drilling/investment and energy prices increased significantly post-2007 during shale boom.","short_title":"Shale revolution and drilling","tags":["energy","natural-resources","markets","information-dynamics"],"date":"2022-01-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2022-01-01-shale-revolution-drilling.md","url":"/build/2022-01-01-shale-rev-bdf5a62ee6894fb16d43c002fbd97580.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"hSDkxP1xDV"}],"key":"uF8baIdo2y"},{"type":"text","value":": ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"DV2G7U7g05"},{"type":"inlineCode","value":"shakya-2022-shale-revolution-drilling","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"VGyrIzlLJs"},{"type":"text","value":"\n","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Q3DI2txLZb"},{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"l0nWCRhpiY"}],"key":"qgbQDzhwyn"},{"type":"text","value":": verified","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"XKhYsGj3Hx"}],"key":"kxVNgQiTYi"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"DNNo1185DK"}],"key":"XAT7ZpX19A"},{"type":"text","value":": Shakya, S., Li, B., & Etienne, X. (2022). Shale revolution, oil and gas prices, and drilling activities in the United States. ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"IqtaI0SpQM"},{"type":"emphasis","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Energy Economics","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"sbRqrNIyKk"}],"key":"VxlzdTW6Ug"},{"type":"text","value":". ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"FOndncj3sK"},{"type":"link","url":"https://www.dropbox.com/scl/fi/o0yruunqmgeig96pqmlag/Shale-Revolution-Oil-and-Gas-Prices-and-Drilling-Activities-in.pdf?rlkey=2fxzwf5jagb8nwrfnue414eqr&dl=0","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"cVdQAWDPqE"}],"urlSource":"https://www.dropbox.com/scl/fi/o0yruunqmgeig96pqmlag/Shale-Revolution-Oil-and-Gas-Prices-and-Drilling-Activities-in.pdf?rlkey=2fxzwf5jagb8nwrfnue414eqr&dl=0","key":"acTDPZD0pt"}],"key":"wKRIxj9dMz"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"k6pkt9eBbz"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"WdhC0pcAvG"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"njqXMaEsav"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"jMMdkv20hn"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"The shale revolution changed US oil and gas markets at a basic level. As unconventional production became economically viable (post-2000s), the relationship between drilling investment and energy prices may have shifted. The question is whether information transmission between exploration/investment activities and energy prices changed magnitude or character during the shale era.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"JJIHvP0Tmr"}],"key":"saRPunZT3L"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"pVk15XrKlu"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"XUlvzsqBeq"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Significant information spillover exists between exploration/investment activities and energy prices. The amount of information transmitted between these variables increased substantially since the shale boom (post-2007), indicating that market dynamics in the unconventional oil/gas era differ at a basic level from pre-shale periods. This suggests that shale production responds more dynamically to price signals.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"NVkSHlBTfm"}],"key":"Vc4YMsmTio"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"OyQsWrMM74"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"tEBms9Ferf"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"US oil and natural gas industries spanning pre-shale through modern unconventional production era (roughly 2000-2020). Drilling activity data and energy price series. Time-varying rolling window approach captures gradual changes in information transmission rather than assuming a single structural break at shale emergence.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"nQawLUZoEL"}],"key":"pjkkge7Ppw"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"OTK0utgUBS"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"x1RhykYnIE"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Time-varying rolling window approach to identify gradual changes in information transmission. Three hypotheses tested: (1) information spillover between drilling/investment and prices, (2) increased spillover intensity since shale boom, (3) natural gas prices and drilling increasingly important transmitters post-shale. Does not assume discrete regime shift but models continuous evolution.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"Ob5GEoqaQe"}],"key":"bi6qF3fybq"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"pJ95eJOTfc"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"JUnugUnLrF"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Rolling window technique assumes gradual change, potentially missing discrete regime shifts. Analysis does not clearly separate price impacts driven by associated gas (from oil wells) versus primary gas production. Shale boom treated as single continuous process rather than multiple distinct phases with different economic characteristics.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"AvC8AezJBD"}],"key":"kkadmubei6"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"EXPfDrxnHc"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"RXxhhcF1bq"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/o0yruunqmgeig96pqmlag/Shale-Revolution-Oil-and-Gas-Prices-and-Drilling-Activities-in.pdf?rlkey=2fxzwf5jagb8nwrfnue414eqr&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"kdfH5OFGBC"}],"urlSource":"https://www.dropbox.com/scl/fi/o0yruunqmgeig96pqmlag/Shale-Revolution-Oil-and-Gas-Prices-and-Drilling-Activities-in.pdf?rlkey=2fxzwf5jagb8nwrfnue414eqr&dl=0","key":"t5MzgnW7eh"}],"key":"XCfuHMIKQe"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"Lji6rRAxyn"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"krFGXGHfvH"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"The shale revolution is not just a supply shock - it changed market dynamics. By showing that information transmission between drilling and prices intensified post-2007, this paper suggests that unconventional producers are more price-responsive than conventional operators. For energy markets, this implies faster adjustment and less lag between price changes and production response. For forecasters and traders, it means that drilling activity is a more reliable real-time indicator of price expectations during the shale era. For policy makers concerned about energy independence or carbon emissions, the result implies that price incentives (carbon taxes, production incentives) will generate faster supply-side responses than they would have pre-shale. The dynamic response of shale also complicates international political analysis - OPEC price-setting power may be weaker when US unconventional producers respond quickly to opportunities.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"SF1zC8u9uH"}],"key":"zcgsacQMFi"}],"key":"vEzIlTruMB"}],"key":"lo0ODy63GL"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Spatial spillovers and the productivity-compensation gap","short_title":"Spatial spillovers and productivity","url":"/book/paper-notes/2022-01-01-spatial-spillovers-productivity-gap","group":"Publications"},"next":{"title":"Productivity spillovers and the productivity-compensation gap","short_title":"Productivity spillovers and compensation","url":"/book/paper-notes/2022-01-01-productivity-spillovers-compensation","group":"Publications"}}},"domain":"http://localhost:3000"}