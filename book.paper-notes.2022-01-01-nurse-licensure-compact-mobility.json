line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"Gliiz0EDjU"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"CgoX7CuqpY"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Occupational licensing restricts worker mobility, but loosening requirements raises quality concerns. Does the Nurse Licensure Compact - allowing multi-state practice without additional licenses - actually increase nurse mobility and address workforce shortages?","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"JPAksZC93z"}],"key":"ObK5M3tpW1"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"gS00LI4Lxx"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"tzVhxpMoYC"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Nurse Licensure Compact adoption increased nurse mobility by 11% among registered and practical/vocational nurses within compact states, addressing COVID-era healthcare workforce needs.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"eRPHHuNKwr"}],"key":"r3tXuzdOmY"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"oOQOs9451j"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"mVSuUe6v5n"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"State-level analysis as of March 2021 with 34 states in compact; regression analysis exploiting staggered state adoption timing.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"GzgAj3rMzr"}],"key":"xAcfOkbVwl"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"z42mZQ47wq"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"fvhNFWPpZu"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Quasi-experimental regression design exploited state-level staggered NLC adoptions to identify causal effects, comparing mobility changes within states over time.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"CZcrjgzjnw"}],"key":"z67f59fxIp"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"cSwJLnM937"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"Xz58ODiOM4"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Analysis measures interstate migration but does not examine whether increased mobility improved patient results, wages, or care quality measures.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"lLso1kncXO"}],"key":"OGzHb1bdAj"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"Wfzr9hMaIT"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"iKoGyK77wb"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/wfiwi8em9sbat5u9fcau2/Nurse-Licensure-Compact-and-Mobility.pdf?rlkey=8oved5beoz93zlxvhfzkzxx9i&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"PHuEmh3Nyp"}],"urlSource":"https://www.dropbox.com/scl/fi/wfiwi8em9sbat5u9fcau2/Nurse-Licensure-Compact-and-Mobility.pdf?rlkey=8oved5beoz93zlxvhfzkzxx9i&dl=0","key":"vQvecd33W0"}],"key":"hI3y5BEZLU"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"SxEgv5fO3v"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"UtDyxiphjT"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Nursing shortages are persistent, especially in rural areas and crisis periods. This paper shows that multi-state licensing agreements measurably increase nurse movement toward shortage areas. For states, the finding validates the Nurse Licensure Compact as an effective policy tool - it works. For healthcare administrators, the 11% mobility increase means that compact participation expands the geographic labor pool. The result is especially relevant post-COVID when nurse turnover spiked and travel nursing became critical: regulatory flexibility to enable movement was consequential. For other licensed professions (physicians, pharmacists, mental health), the paper provides a proof-of-concept that reciprocal licensing can overcome geographic supply-demand gaps without compromising quality assurance. The finding also suggests that “nursing shortage” policy should focus on removing geographic barriers, not just increasing supply through education or recruitment.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"Aea2Rhlk0L"}],"key":"pyf0rOcvHO"}],"key":"kCE6cJKQpH"}],"key":"kOI0lMIycG"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Productivity spillovers and the productivity-compensation gap","short_title":"Productivity spillovers and compensation","url":"/book/paper-notes/2022-01-01-productivity-spillovers-compensation","group":"Publications"},"next":{"title":"Natural disasters and labor migration in Nepal","short_title":"Nepal earthquake and migration","url":"/book/paper-notes/2022-01-01-nepal-earthquake-labor-migration","group":"Publications"}}},"domain":"http://localhost:3000"}