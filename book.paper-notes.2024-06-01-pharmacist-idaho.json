en":[{"type":"text","value":"Policy hook","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"mp9M9c1y92"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"pUwO3avrT3"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Scope-of-practice restrictions limit healthcare access for time-sensitive conditions. When Idaho granted pharmacists prescriptive authority, did it improve access to critical treatments like rescue inhalers and insulin pen needles?","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"zu1ahSrRMK"}],"key":"J95mCUIDZS"},{"type":"heading","depth":3,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"rHW5VtNfra"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"xwgsm8h9BK"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Pharmacist prescriptive authority in Idaho increased Medicare Part D claims, 30-day fills, and 30-day supplies of albuterol sulfate and insulin pen needles, providing approximately three additional patients per pharmacist timely care.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"jNLWYNOMyQ"}],"key":"u5rUa4PwM7"},{"type":"heading","depth":3,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"zwdCoW21N8"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"WaiiqCVZw3"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Medicare beneficiaries in Idaho following HB 191 (2018); permitted pharmacists to prescribe 20 drug and device categories; policy rolled out January 2019.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"jAkL1oCyQS"}],"key":"UKnjfz0qgc"},{"type":"heading","depth":3,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"RGvBNAd8Wa"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"oscZ9ISuBs"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Evaluation of Idaho’s pioneering pharmacist prescriptive authority policy measuring claims and fill data before and after July 2018 Board of Pharmacy implementation rules.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"g84QbsmYtA"}],"key":"jh3otwzmJO"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"NXWWLho185"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"gtarMd8WV5"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Focuses on Medicare beneficiaries only; does not measure wider population impacts, emergency department utilization, or whether access improvements translated to health outcome gains.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"YIEmuCM3YX"}],"key":"WgUZwvzDfi"},{"type":"heading","depth":3,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"mw8hudlcjQ"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"egSufkXkFH"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"cite","url":"https://onlinelibrary.wiley.com/doi/full/10.1111/coep.12647","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Publisher page","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"c2Suys5b41"}],"kind":"narrative","label":"Shakya_2024","identifier":"https://onlinelibrary.wiley.com/doi/full/10.1111/coep.12647","enumerator":"1","key":"wd9gNvjSJu"}],"key":"rdARR0isJV"},{"type":"heading","depth":2,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"rcUUnOmKnh"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"tYcRpwfcgW"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Pharmacists are highly trained but used too little in many states. This paper demonstrates that relaxing scope-of-practice restrictions improves real-world access to time-sensitive medications. The finding is particularly important for rural areas where pharmacies are present but physician offices are not - pharmacist prescribing authority can fill that gap. For Medicare beneficiaries, better access to rescue inhalers and insulin supplies means better disease management and fewer emergency hospitalizations. For pharmacies and pharmacy chains, the result validates expanded roles as a competitive and social advantage. For other states considering similar legislation, Idaho provides evidence that the change works - access improves without apparent downsides. The limitation (Medicare-only data) is important: young people, uninsured populations, and non-Medicare seniors may show different patterns. But the proof-of-concept is strong: professional licensing reform can address access barriers when credentialing processes ensure quality.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"CY8l5y4fSS"}],"key":"l9M8pjVtGS"}],"key":"ETR1Bvprdn"}],"key":"HabdeCQOes"},"references":{"cite":{"order":["Shakya_2024"],"data":{"Shakya_2024":{"label":"Shakya_2024","enumerator":"1","doi":"10.1111/coep.12647","html":"Shakya, S., Plemmons, A., Bae, K., & Timmons, E. (2024). The pharmacist will see you now: Pharmacist prescriptive authority and access to care. <i>Contemporary Economic Policy</i>, <i>43</i>(1), 161–174. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1111/coep.12647\">10.1111/coep.12647</a>","url":"https://doi.org/10.1111/coep.12647"}}}},"footer":{"navigation":{"prev":{"title":"Maternity care deserts in North Carolina","short_title":"Maternity care deserts NC","url":"/book/paper-notes/2025-01-01-maternity-care-deserts-nc","group":"Publications"},"next":{"title":"Substance use Certificate-of-Need laws and treatment access","short_title":"SUD Certificate-of-Need","url":"/book/paper-notes/2024-05-01-sud-certificate-of-need","group":"Publications"}}},"domain":"http://localhost:3000"}