nd":{"line":31,"column":1}},"children":[{"type":"text","value":"Afghanistan’s university entrance examination data; analysis of gender gaps in test performance with cultural variables.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"RRcs3dIN26"}],"key":"QGGxn6qabv"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"eCosScUH2I"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"MA23Pb0s9Q"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Econometric analysis examining how cultural factors moderate or explain gender gaps in university entrance exam performance in Afghanistan.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"o9BOdjwHf8"}],"key":"sRXKNBgFYr"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"o2aWREydBz"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"XP37MvDanz"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Cross-sectional test score data cannot identify specific mechanisms through which culture operates or establish causality between cultural variables and achievement gaps.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"thvsRB9fnj"}],"key":"xWivZaimRO"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"EPNqEKlktt"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"QYGdne524p"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"cite","url":"https://www.tandfonline.com/doi/pdf/10.1080/13504851.2024.2332523","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Publisher page","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"ufvwk42boS"}],"kind":"narrative","label":"Mobariz_2024","identifier":"https://www.tandfonline.com/doi/pdf/10.1080/13504851.2024.2332523","enumerator":"1","key":"wrcP8wZvwO"}],"key":"jkC5bujf1B"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"r9m9it8HTa"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"KEjrvqSFYi"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Gender gaps in educational achievement are persistent globally, especially in conflict-affected and patriarchal societies. Understanding whether gaps stem from schooling quality, cultural norms, or family resources is needed for policy design. This paper’s finding that culture shapes test scores in Afghanistan has consequences for post-conflict education policy: if cultural factors are significant, education alone (more schools, more teachers) won’t close gaps; parallel efforts addressing norms and expectations may be needed. For Afghanistan specifically, the results suggest that university entrance exam design and policy implementation should account for cultural dynamics affecting different groups. For girls’ education globally, the paper highlights that gaps often reflect not student ability but social/cultural barriers to achievement recognition. For education economists, it demonstrates that standard schooling inputs explain only part of gender gaps in achievement; institutional and cultural settings matter. The limitation (cross-sectional data) prevents identifying exact mechanisms, but the finding that culture matters is itself policy-relevant and should shape how policy makers target programs.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"kmcu1W4QD0"}],"key":"tuweB09YHR"}],"key":"x5JwC3Ytam"}],"key":"vTPCKmAEXG"},"references":{"cite":{"order":["Mobariz_2024"],"data":{"Mobariz_2024":{"label":"Mobariz_2024","enumerator":"1","doi":"10.1080/13504851.2024.2332523","html":"Mobariz, A. S., & Shakya, S. (2024). Cultural influences on gender gap in test scores: findings from Afghanistan’s university entrance examination. <i>Applied Economics Letters</i>, <i>32</i>(14), 2015–2018. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1080/13504851.2024.2332523\">10.1080/13504851.2024.2332523</a>","url":"https://doi.org/10.1080/13504851.2024.2332523"}}}},"footer":{"navigation":{"prev":{"title":"Anti-maintenance of certification and elderly physician supply","short_title":"Anti-MOC and physician supply","url":"/book/paper-notes/2024-01-01-anti-moc-elderly-physician-supply","group":"Publications"},"next":{"title":"APRN full practice authority, supply, and outcomes","short_title":"APRN FPA border analysis","url":"/book/paper-notes/2023-06-01-aprn-fpa-border","group":"Publications"}}},"domain":"http://localhost:3000"}