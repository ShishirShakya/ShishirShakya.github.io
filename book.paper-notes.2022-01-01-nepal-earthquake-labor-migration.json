{"version":3,"kind":"Article","sha256":"77ae7448c7d9c14860255bdb10d01155e0a098dee6e73cb3d9516f964445fd59","slug":"book.paper-notes.2022-01-01-nepal-earthquake-labor-migration","location":"/book/paper-notes/2022-01-01-nepal-earthquake-labor-migration.md","dependencies":[],"frontmatter":{"title":"Natural disasters and labor migration in Nepal","description":"2015 Nepal earthquake increased international labor migration by 1.5 percentage points in severely affected districts.","short_title":"Nepal earthquake and migration","tags":["international-development","labor","migration","natural-disasters"],"date":"2022-01-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2022-01-01-nepal-earthquake-labor-migration.md","url":"/build/2022-01-01-nepal-ear-11e4a48f77cb7fce49d65375dde3702a.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"X18ySGTdMD"}],"key":"kXE6kBdtsr"},{"type":"text","value":": ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"EIh1q8dLPn"},{"type":"inlineCode","value":"shakya-2022-nepal-earthquake-labor-migration","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"MFwi05FIfc"},{"type":"break","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"HFGfeSTfVc"},{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"T8mIzjRpwd"}],"key":"vBefye3mQh"},{"type":"text","value":": verified","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"UE9HBjewyM"}],"key":"viwExeTeNY"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"qGBs5Y75fz"}],"key":"FhhXhEAyg9"},{"type":"text","value":": Shakya, S., Basnet, S., & Paudel, J. (2022). Natural disasters and labor migration: Evidence from Nepal’s earthquake. ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"QOJih2DYdq"},{"type":"emphasis","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"World Development","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"yT8nWzMojG"}],"key":"ArzrEJwWsu"},{"type":"text","value":". ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"eGmG1tatPx"},{"type":"link","url":"https://www.dropbox.com/scl/fi/883lv35mzgnhdfnlmyeqt/Natural-disasters-and-labor-migration-Evidence-from-Nepal-s-earthquake.pdf?rlkey=8in4xafkl8su5e950dpn0uqrn&dl=0","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"MVjXE38bBp"}],"urlSource":"https://www.dropbox.com/scl/fi/883lv35mzgnhdfnlmyeqt/Natural-disasters-and-labor-migration-Evidence-from-Nepal-s-earthquake.pdf?rlkey=8in4xafkl8su5e950dpn0uqrn&dl=0","key":"K5xOAlPhty"}],"key":"GSzXauZvqz"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"pkNCkdF4DP"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"tTCqVfoqDE"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"EtROj1f24w"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"iUiBpLoDQr"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Natural disasters disrupt economic livelihoods. One household response is labor migration—leaving home for employment elsewhere. Understanding how disasters trigger migration is critical for development policy, disaster response, and predicting population movements post-crisis. This paper examines whether major earthquakes causally increase international labor migration.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"AQyJp0dAyc"}],"key":"hzbKeb8iEt"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"qZ4a0dfEH4"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"NLgnIxN3d7"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"The 2015 April earthquake in Nepal increased out-migration rates at the district level by 1.5 percentage points among severely affected districts compared to unaffected control districts. This effect is statistically significant and substantial given baseline migration rates, indicating that earthquakes trigger household-level migration responses as a livelihood adaptation strategy.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"FZ7R1tqlnC"}],"key":"JTn1YUgRtP"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"uvZvwh0Ehq"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"gIo7HgLanj"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"2015 Nepal earthquake with 14 severely affected districts (National Reconstruction Authority classification) versus 61 unaffected control districts. International labor migration measured through work permits from Nepal’s Department of International Employment (DoFE) for temporary contract workers. Data focuses on documented legal labor migration (approximately 85% of 2008–2015 international migration from Nepal to Gulf countries).","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"gacdKoggGG"}],"key":"jEsrLXLf23"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"ns4q1J5V4W"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"YckED2skgx"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Difference-in-differences research design exploiting plausibly exogenous variation in earthquake severity across districts. Interactive fixed effects (Bai 2009) augmented within DID framework to control for nationwide time trends and time-varying unobserved heterogeneity. Compares pre- and post-earthquake migration trends between affected and unaffected districts.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"cxe4XXBcyo"}],"key":"DO9yARUnks"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"iK4o5igcCl"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"DQUczQfobw"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Study focuses exclusively on documented legal labor migration via work permits; cannot examine undocumented/illegal labor migration due to lack of reliable data. Internal migration to India unexamined due to lack of regulation/documentation. Estimates may reflect both push effects (earthquake damage) and pull effects (reconstruction employment opportunities), which cannot be separately identified.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"SDj6UG2ihW"}],"key":"KvIk5FpcHY"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"MYOp06BBLt"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"D8wGpubneB"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/883lv35mzgnhdfnlmyeqt/Natural-disasters-and-labor-migration-Evidence-from-Nepal-s-earthquake.pdf?rlkey=8in4xafkl8su5e950dpn0uqrn&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"x7RIvHVXYA"}],"urlSource":"https://www.dropbox.com/scl/fi/883lv35mzgnhdfnlmyeqt/Natural-disasters-and-labor-migration-Evidence-from-Nepal-s-earthquake.pdf?rlkey=8in4xafkl8su5e950dpn0uqrn&dl=0","key":"Ae94opBTIJ"}],"key":"TttAA6zshG"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"g7cJwmT9u2"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"xdJ2x1QmfE"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Earthquakes kill and destroy, but households also respond strategically by migrating for work. This paper shows the effect is real and substantial—natural disasters increase international labor migration, likely as households seek income to rebuild. For disaster response policy, the finding suggests that post-earthquake employment creation is a priority (not just housing or medical care)—without local jobs, migration becomes the livelihood strategy. For labor-receiving countries, earthquake-driven migration spikes may be predictable and temporary. For Nepal specifically, remittances from earthquake-displaced workers represented crucial income for affected households. The work complicates the narrative of “disaster-induced forced displacement”—many moves are not permanent relocations but temporary labor migration for reconstruction resources. This has implications for humanitarian policy: supporting in-place recovery may be more cost-effective than managing displacement when temporary migration for income is the household response.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"wrPlQZqMDX"}],"key":"Yd43cSwL2O"}],"key":"QMTcuhSRKX"}],"key":"SgzQ0ZL1zU"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Nurse licensure compact and mobility","short_title":"Nurse licensure compact mobility","url":"/book/paper-notes/2022-01-01-nurse-licensure-compact-mobility","group":"Publications"},"next":{"title":"Must-access PDMPs and retail opioid sales","short_title":"Must-access PDMP and opioids","url":"/book/paper-notes/2022-01-01-must-access-pdmp-retail-opioids","group":"Publications"}}},"domain":"http://localhost:3000"}