{"version":3,"kind":"Article","sha256":"9a6235ee4dd0ee66326f8ec4e9434c7d61b418d82ae7bda5265a940b4f7d63e2","slug":"book.paper-notes.2024-01-01-anti-moc-elderly-physician-supply","location":"/book/paper-notes/2024-01-01-anti-moc-elderly-physician-supply.md","dependencies":[],"frontmatter":{"title":"Anti-maintenance of certification and elderly physician supply","description":"Anti-MOC state laws increase the supply of older physicians, with larger effects in states implementing full prohibition.","short_title":"Anti-MOC and physician supply","tags":["healthcare","physician","workforce","regulation"],"date":"2024-01-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2024-01-01-anti-moc-elderly-physician-supply.md","url":"/build/2024-01-01-anti-moc--608cedcf7b639af09db1f36ac06270ea.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"lKSZOu1yy5"}],"key":"SbF1lhdvtK"},{"type":"text","value":": ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"ZKkVS0J7ln"},{"type":"inlineCode","value":"shakya-2024-anti-moc-elderly-physician","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"LAt9J4TNDH"},{"type":"break","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"io4rxiwTKS"},{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"VoIKB2lxBw"}],"key":"ilWZzBsGtd"},{"type":"text","value":": verified","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"qwkDBbPT6P"}],"key":"FlxoCLVNzi"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"IdY29vRZwy"}],"key":"zASBbhNVc6"},{"type":"text","value":": Shakya, S., Nepal, T., Mathew, M., & Timmons, E. (2024). Anti-maintenance of certification and elderly physician supply. ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"vO3OQQoH7l"},{"type":"emphasis","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Economics Letters","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"jSN7fuzyUD"}],"key":"S6bqS1IDSz"},{"type":"text","value":". ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"fwTC4f43oa"},{"type":"link","url":"https://www.dropbox.com/scl/fi/fqb0916bkwk97m4we1riz/Anti-maintenance-of-certification-and-elderly-physician-supply.pdf?rlkey=2qqz14u2x47qfjy7ravd7d0o7&st=r1x2agmo&dl=0","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"WqrtxGFvqe"}],"urlSource":"https://www.dropbox.com/scl/fi/fqb0916bkwk97m4we1riz/Anti-maintenance-of-certification-and-elderly-physician-supply.pdf?rlkey=2qqz14u2x47qfjy7ravd7d0o7&st=r1x2agmo&dl=0","key":"wnEEbgc8HD"}],"key":"vZevkGf0Dc"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"LDDVcZdAWp"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"opphFK3TX3"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"ptvn55m80A"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"hHKdojNjqo"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"States argue that Maintenance of Certification (MOC) requirements are expensive and burdensome for physicians. Some states have passed anti-MOC laws to eliminate or reduce these requirements. The policy question is whether lifting MOC requirements increases the supply of older physicians who remain in practice or attract them from other states.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ZYw41yN9AB"}],"key":"XspRnoYCiC"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"B0bEoP1lGV"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"TXyoC7hVZl"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Anti-MOC states show a statistically significant biannual increase of 1.4–1.9 percentage points in the share of older physicians (age 60+). States implementing full anti-MOC prohibition show larger effects of 1.9 percentage points (p<0.01). No significant effect appears for younger physicians under 60. This translates to approximately 4,732 additional older physicians nationwide biennially from the 1.4 percentage point increase.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"IBMQpFH76q"}],"key":"g59TjTvqVh"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"RBuoh1G2bl"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"tHmTyBLHTV"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"State Physician Workforce Data Report, biennial intervals, covering all 50 states and DC from 2006 to 2020. Six states implemented full anti-MOC prohibition during the study period, while eight additional states implemented partial anti-MOC restrictions. The outcome is the proportion of active physicians aged 60 and older in each state-year.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"MbwUFLmvAK"}],"key":"eiJScKjdNk"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"sS3acXqM34"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"C9kE7dOhaz"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"The paper uses a generalized difference-in-differences design with state and year fixed effects to estimate the impact of anti-MOC laws on the share of older physicians. Event study methods test for parallel pre-trends and estimate dynamic treatment effects. Regressions are weighted by the number of older physicians per state-year to account for state size variation. The identification strategy compares older physician shares before and after anti-MOC adoption, controlling for common temporal trends and permanent state-level differences.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"x4JLEtH8Wn"}],"key":"u25Ve95xIz"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"VcE5v5FlLd"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"p0ud0ArawV"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Biennial treatment effects are modest in magnitude. Full anti-MOC prohibition states show larger effects than partial-prohibition states. The analysis cannot distinguish whether increased shares reflect older physicians staying longer in practice versus relocating from other states. Workforce survey data may have measurement error, and changes could reflect data reporting changes rather than true supply shifts.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"KeJywgP3fu"}],"key":"wmN6HccqlS"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"SI85nVt2h4"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"ZcYlhATuy9"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/fqb0916bkwk97m4we1riz/Anti-maintenance-of-certification-and-elderly-physician-supply.pdf?rlkey=2qqz14u2x47qfjy7ravd7d0o7&st=r1x2agmo&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"zUjMUuYDkD"}],"urlSource":"https://www.dropbox.com/scl/fi/fqb0916bkwk97m4we1riz/Anti-maintenance-of-certification-and-elderly-physician-supply.pdf?rlkey=2qqz14u2x47qfjy7ravd7d0o7&st=r1x2agmo&dl=0","key":"sQlzKtHgbF"}],"key":"krdBBR1Kzm"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"tRhgizQZWf"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"qlL3NAJffr"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Physician shortages are a persistent challenge for healthcare access. MOC requirements, originally designed to maintain quality standards, impose substantial costs and time burdens on physicians—particularly those nearing retirement. This paper shows that eliminating MOC requirements noticeably increases the share of older physicians in practice. For states facing aging populations and rural shortages, anti-MOC laws may be an effective, low-cost policy tool to retain experienced clinicians. The effect is largest under full prohibition, suggesting that partial restrictions have limited efficacy. The findings suggest that regulatory burden reduction can influence workforce decisions at the margin, especially for professionals considering retirement. However, the modest magnitude of effects and focus on aggregate state-level shares means anti-MOC laws are one piece of a broader physician shortage solution, not a comprehensive fix. The policy points to a tension between maintaining certification standards and enabling continued practice for experienced providers.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"CnpNKAhszv"}],"key":"yNBYIyWVgT"}],"key":"HC03sNJRzs"}],"key":"QLdJxsfqPl"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Grading policy, email nudges, and grade outcomes","short_title":"Grading policy and nudges","url":"/book/paper-notes/2024-01-01-grading-policy-email-nudges","group":"Publications"},"next":{"title":"Cultural influences on gender gap in test scores in Afghanistan","short_title":"Gender gap and culture Afghanistan","url":"/book/paper-notes/2024-01-01-afghanistan-gender-gap-tests","group":"Publications"}}},"domain":"http://localhost:3000"}