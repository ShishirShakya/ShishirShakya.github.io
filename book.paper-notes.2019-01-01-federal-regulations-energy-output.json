osition":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"CdlDI7vMmj"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"tnQ1gmxPbE"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Federal regulations profoundly affect energy production and environmental outcomes, but the relationship is complex and nonlinear. How does accumulated federal regulation affect U.S. energy sector output at different regulatory intensity levels?","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"nv8adQ3xDW"}],"key":"OzQR0h0TJ1"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"x6xQfWxaJt"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"rdZonK4MmX"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Federal regulations and U.S. energy sector output follow an inverted U-shape: at low regulatory levels, additional regulations increase output, but as regulations accumulate, further increases lead to declining output.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"zEXqau4RMK"}],"key":"O9PpDwLkbK"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"YaKaZk0N1K"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"ltEfPYsVse"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"U.S. energy sector data analyzed using panel ARDL model; regulatory burden measured using RegData federal regulation measure.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"pvxlZgwDP5"}],"key":"zZcyLtJtyU"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"RFEVkTkUhE"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"bVeAWTijrr"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Panel ARDL model capturing dynamic relationships and lags between regulatory changes and sector output. Inverted U-shape suggests different regulatory regimes have opposing effects.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"Oi9L9IvtKj"}],"key":"B1P3ySLPnQ"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"Ro46l7UUP5"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"BgouEWyIsg"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Aggregate energy sector output measured without separately accounting for environmental damages or distinguishing responses between different energy types.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"BhWGoxFlnV"}],"key":"eqlIaeXiNC"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"jvVCUuchIm"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"lleM22xBE0"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/evx1qev6p272vi87ogv3p/Federal-Regulations-and-U.S.-Energy-Sector-Output.pdf?rlkey=ewrftnbawujwqsaiqqvhko9m7&dl=0","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"GZ8sjBxHHY"}],"urlSource":"https://www.dropbox.com/scl/fi/evx1qev6p272vi87ogv3p/Federal-Regulations-and-U.S.-Energy-Sector-Output.pdf?rlkey=ewrftnbawujwqsaiqqvhko9m7&dl=0","key":"Jb5rFBljF7"}],"key":"xS8FO1qtSL"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"QqudstxiXZ"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"X3xfllK6Pa"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Regulations are controversial: some argue they stifle production, others that they ensure safety and environmental protection. This paper’s inverted-U finding suggests both sides have a point. Very light regulation may leave room for harmful practices and inefficiency, and some regulation boosts productivity (clearer rules, level playing field). But excessive regulation eventually becomes counterproductive, reducing output. For energy policymakers, this implies that regulatory design matters more than regulatory quantity—not all regulations have equal effects. The finding also suggests that historical comparisons (US energy output under different administrations) must account for accumulated regulatory stock, not just recent changes. For other industries, the inverted-U pattern offers a middle-ground framework: find the optimal regulatory level rather than assume “more” or “less” is always better. The work implies that both deregulation advocates and strong regulators might miss the efficiency-maximizing point.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"TIQdXBiz2D"}],"key":"yqSeCrJtqe"}],"key":"wKa8bDVrLS"}],"key":"yQYx7wAgnB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Announcement effects in US lumber futures market","short_title":"Lumber futures announcements","url":"/book/paper-notes/2020-01-01-lumber-futures-announcement","group":"Publications"},"next":{"title":"Electricity consumption and economic growth in Nepal","short_title":"Electricity and growth Nepal","url":"/book/paper-notes/2018-01-01-electricity-consumption-nepal","group":"Publications"}}},"domain":"http://localhost:3000"}