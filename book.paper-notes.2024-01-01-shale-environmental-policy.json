tion":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"P2UxgqUILC"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"CPWqZKGj8Z"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"P49Pv68uiX"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"RnhhlIYqQR"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Policy makers use bonding requirements (financial guarantees) to compel oil and gas firms to absorb environmental costs of drilling, particularly for well abandonment and reclamation. The question is whether firms respond by complying with environmental standards or by exiting the market - a response that might undermine policy intent by leaving wells abandoned and cleanup costs with the state.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"woORIKkdHQ"}],"key":"TxgidWKXKH"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"Q0PgXe4FSn"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"XafQvJvgr8"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"When jurisdictions increase drilling bonding requirements, firms respond by exiting the unconventional oil and gas industry rather than increasing compliance efforts. West Virginia’s increase from ","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"ojiGcRPoGK"},{"type":"inlineMath","value":"5,000 to ","posit