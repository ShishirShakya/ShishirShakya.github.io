:{"line":21,"column":1}},"key":"yOsOtqJu4k"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"RAsrOnkwQT"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Replication studies are needed for science credibility, but how often do published findings hold up under replication? Can researchers reproduce a specific empirical claim from prior criminology research?","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"XZ5w30W88y"}],"key":"LD6KUFeLCN"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"AQ40CS04Au"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"z3sfAoRwRc"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Structured replication attempt of Bersani and Doherty (2013) research through the Systematizing Confidence in Open Research and Evidence (SCORE) project examines the robustness of original claims.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"VuKMZ5TGO3"}],"key":"HHZeaNy2sJ"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"iuT8xIzOMo"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"nkDIQ82dr5"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Replication study coordinated through Center for Open Science SCORE Project, attempting to reproduce research claim from Bersani and Doherty (2013) in criminology.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"wwt2tXmJM7"}],"key":"MBbA5sPWZO"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"AQXfcofUnp"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"M777SdfN8d"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Systematic replication protocol applied to test whether original research results can be reproduced using similar or identical methodology with independent samples.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"uG7GF7EZAb"}],"key":"qkr0qswt16"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"cyDJkytjCV"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"SYUu9Qty72"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Replication results depend heavily on exact following the protocol and data availability; negative results may reflect implementation differences rather than true non-replicability.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"utLV9ipTJD"}],"key":"Lmfd5JPNxj"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"eDzRonVroV"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"bmHsw5dMXE"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://osf.io/9bme4","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"OSF Project","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"rIZbyCARGM"}],"urlSource":"https://osf.io/9bme4","key":"Q7OA9iKqqF"}],"key":"PfBxuebRPg"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"my4aJDgnJK"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"RXQjxC7De8"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Criminology is a policy-relevant discipline: conclusions inform crime prevention and law enforcement. But do empirical claims replicate? This SCORE replication tests a published criminology result, contributing to wider efforts to assess which crime research findings are strong. For criminologists, replication results (whether positive or negative) improve the field’s self-correction mechanisms. For policy makers, replication results inform confidence in evidence: results that don’t replicate shouldn’t drive policy, while strong replications validate evidence-based approaches. The SCORE project is important because systematic replication is rare; most published research never undergoes external replication. By documenting what does and doesn’t replicate, SCORE helps policy makers distinguish reliable findings from likely false positives. For this specific criminology claim, the replication outcome contributes to cumulative evidence in the field. Negative results don’t discredit the original authors - implementation differences or data differences can explain failures - but they signal caution about generalizing findings.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"AKWE0yFRH6"}],"key":"zOwKfZ6Obu"}],"key":"OkPLNmycma"}],"key":"KhtnAox9ei"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Political economy of Vermont's abortion bill","short_title":"Vermont abortion bill","url":"/book/paper-notes/2020-01-01-vermont-abortion-bill","group":"Publications"},"next":{"title":"Scope of practice and NP mobility serving Medicare beneficiaries","short_title":"NP scope and Medicare mobility","url":"/book/paper-notes/2020-01-01-np-sop-medicare-mobility","group":"Publications"}}},"domain":"http://localhost:3000"}