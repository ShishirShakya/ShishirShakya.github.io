[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"gWXK12Sij4"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"gjC8CujSpL"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Experiment conducted in college setting with self-selected student participants; results may not generalize to K-12 or other educational levels or student populations.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"sOb4pKmJWb"}],"key":"VDFuXvyYDN"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"oTpxLuY3y6"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"VmCo2o9nEP"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Add publisher or preprint link when available. See ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"Px7zf5FNbm"},{"type":"link","url":"/book/cv/publications","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"publications","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"YuafW8LlTp"}],"urlSource":"../cv/publications.md","dataUrl":"/book.cv.publications.json","internal":true,"protocol":"file","key":"LAM5cjUidS"},{"type":"text","value":".","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"dVql6Y55aW"}],"key":"NZoPRCSidq"}],"key":"XgGJp6OHvh"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"vpXVzLzel9"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"boADwZgUcQ"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Generative AI’s impact on education is hotly debated: will it widen tutoring access, or will it replace understanding with pattern-matching shortcuts? This paper’s experimental evidence shows that AI-enhanced study groups can improve learning when designed thoughtfully - specifically, when the AI tool prompts reasoning rather than providing answers. For educators, the result validates AI as a learning tool but points to the importance of teaching design: not all AI implementations work equally well. For students, it suggests that AI tutoring can supplement or improve study time, particularly for problem-solving and reasoning tasks. For policy, the finding supports measured adoption of AI in education - not a wholesale replacement of instruction, but targeted integration. For economists, the work uses experimental methods to evaluate a new technology, a model for evidence-based edtech adoption. The limitation (college student sample) is important - lower grades, different populations, and other settings may show different results. But the proof-of-concept is clear: well-designed AI tutoring can improve learning results.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"kKwTTj9VK4"}],"key":"aUh2xqw1vg"}],"key":"JZvnpPR5pC"}],"key":"c9QXeYIFf1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Access to mental health care and suicide rates","short_title":"Mental health access and suicide","url":"/book/paper-notes/2026-06-01-mental-health-suicide-jpam","group":"Publications"},"next":{"title":"Athletic reclassification and local entrepreneurial ecosystems","short_title":"Town, gown, and touchdowns","url":"/book/paper-notes/2026-01-01-town-gown-touchdowns","group":"Publications"}}},"domain":"http://localhost:3000"}