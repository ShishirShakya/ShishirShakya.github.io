:"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"zodCc6JmQB"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"OslnjillEU"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Experiment conducted in college setting with self-selected student participants; results may not generalize to K-12 or other educational levels or student populations.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"sIzYftdSO5"}],"key":"BixP60N4hJ"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"mPjWeoeApr"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"rDfAPTBNOv"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Add publisher or preprint link when available. See ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"QU2RE2tD7g"},{"type":"link","url":"/book/cv/publications","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"publications","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"vpLKLsVzmk"}],"urlSource":"../cv/publications.md","dataUrl":"/book.cv.publications.json","internal":true,"protocol":"file","key":"EBZLvGdumb"},{"type":"text","value":".","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"k5esmG7UUX"}],"key":"X1HC6qWaQ8"}],"key":"nWK0DV0RYZ"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"shnozBNO3z"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"vZKLdmy40S"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Generative AI’s impact on education is hotly debated: will it democratize tutoring access, or will it replace understanding with pattern-matching shortcuts? This paper’s experimental evidence shows that AI-enhanced study groups can improve learning when designed thoughtfully—specifically, when the AI tool prompts reasoning rather than providing answers. For educators, the result validates AI as a learning tool but emphasizes the importance of pedagogical design: not all AI implementations work equally well. For students, it suggests that AI tutoring can supplement or enhance study time, particularly for problem-solving and reasoning tasks. For policy, the finding supports measured adoption of AI in education—not a wholesale replacement of instruction, but strategic integration. For economists, the work uses experimental methods to evaluate a new technology, a model for evidence-based edtech adoption. The limitation (college student sample) is important—lower grades, different populations, and other contexts may show different results. But the proof-of-concept is clear: well-designed AI tutoring can measurably improve learning outcomes.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"ZGYM7tXYsu"}],"key":"wdJwRN7MNi"}],"key":"lIe7li6vKy"}],"key":"kh9gtP21SU"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Access to mental health care and suicide rates","short_title":"Mental health access and suicide","url":"/book/paper-notes/2026-06-01-mental-health-suicide-jpam","group":"Publications"},"n