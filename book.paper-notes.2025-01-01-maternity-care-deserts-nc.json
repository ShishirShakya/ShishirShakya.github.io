:{"line":23,"column":1}},"children":[{"type":"strong","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ZlbkRe0tE5"}],"key":"EKv2nm6sDo"},{"type":"text","value":": Sugg, M., Shakya, S., Ulrich, S., Tyson, J. S., & Runkle, J. (2025). Mapping maternity care deserts: Driving distance and health outcomes in North Carolina. ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"NKjaIhRY1w"},{"type":"emphasis","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"The Journal of Rural Health","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"k6uFu4xrkg"}],"key":"lGypadR5t0"},{"type":"text","value":", 41, e70020. ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"IQtCrGRJ1w"},{"type":"cite","url":"https://doi.org/10.1111/jrh.70020","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Sugg ","key":"Ur45GAtU9l"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"VYePZi3h2k"}],"key":"OA9siZxWrj"},{"type":"text","value":" (2025)","key":"adadWWktb9"}],"kind":"narrative","label":"Sugg2025Mapping","identifier":"https://doi.org/10.1111/jrh.70020","enumerator":"1","key":"l1luvOq6G9"},{"type":"text","value":" ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"LeLsYJWHKU"},{"type":"link","url":"https://www.dropbox.com/scl/fi/6vupzn4iwu2jzzl4gnhtc/The-Journal-of-Rural-Health-2025-Sugg-Mapping-maternity-care-deserts-Driving-distance-and-health-outcomes-in-North.pdf?rlkey=zia9y7p4vinyz5uc72q0lzuct&st=g5om58hn&dl=0","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"pOzasHYSsx"}],"urlSource":"https://www.dropbox.com/scl/fi/6vupzn4iwu2jzzl4gnhtc/The-Journal-of-Rural-Health-2025-Sugg-Mapping-maternity-care-deserts-Driving-distance-and-health-outcomes-in-North.pdf?rlkey=zia9y7p4vinyz5uc72q0lzuct&st=g5om58hn&dl=0","key":"pbNgnEnzH9"}],"key":"XwVkmEcnNC"},{"type":"heading","depth":2,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"gegeO5SD8y"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"X1amHcJYak"},{"type":"heading","depth":3,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"jsMrUreu1J"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"b7uhwjx545"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Access to maternity care is declining across the U.S. despite rising maternal deaths and adverse outcomes. Between 2006 and 2020, over 400 maternity services closed, with disproportionate impact on Black women. Maternity care deserts—geographic areas with limited or no maternal health services—affect 2.3 million women and up to 150,000 births nationally according to the March of Dimes. Understanding which areas and populations are most affected by declining access is an emerging research priority as maternal mortality rates continue to rise.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"TbbxjEBtDi"}],"key":"oLOUDWxr8M"},{"type":"heading","depth":3,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"PRlpiygImH"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"yVKlEoLVQX"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Increased driving distance to obstetric/gynecological providers was significantly associated with worse maternal and infant health outcomes in North Carolina. Women in the lowest access areas experienced higher rates of gestational diabetes (aOR: 1.15), preterm birth (aOR: 1.18), hypertensive disorders of pregnancy (aOR: 1.03), cesarean delivery (aOR: 1.23), and severe maternal morbidity (SMM20: aOR 1.09; SMM21: aOR 1.61). Rural and low-income areas had significantly fewer providers, longer travel times, and longer driving distances. Notably, socioeconomic status emerged as a stronger determinant of provider access than racial composition in North Carolina.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"B7UTogojDh"}],"key":"XP34YUYbDN"},{"type":"heading","depth":3,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"eT4HntrpdD"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"lDf06A3n7A"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":37,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Data sources","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"h8jvYCdUoh"}],"key":"a0LUOaFbbL"},{"type":"text","value":": National Plan and Provider Enumeration System (NPPES) from Centers for Medicare & Medicaid Services (2016–2021); North Carolina inpatient hospitalization records for pregnant persons (2016–2021)","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"XUJBM9h6FS"}],"key":"WX0y2Cfbs7"}],"key":"MUOZqW4Km9"},{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Population","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"XrjiUJuID4"}],"key":"QEfmPCAEyP"},{"type":"text","value":": Residents of North Carolina with pregnancy-related hospitalizations (2016–2021)","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"rXSlZvVVys"}],"key":"P9X5m0x5Mu"}],"key":"ckCnBN45wc"},{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Geographic scale","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"uFbvbjwbBB"}],"key":"dR53MUgAJY"},{"type":"text","value":": Zip Code Tabulation Areas (ZCTA) with travel metrics calculated from residential areas to nearest OB/GYN providers","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"mpVzmHTtvU"}],"key":"qL4bV9w4sx"}],"key":"xrfc3q0J1m"},{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Time period","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"oDU3dnfOm5"}],"key":"in5q91NFRx"},{"type":"text","value":": 2016–2021 (study period); separate pre- and post-COVID-19 pandemic analysis","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"tmmBgE74Ys"}],"key":"uCo2V3ZdjB"}],"key":"QRfeZyO2by"},{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Provider identification","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"VhPFYOXiqi"}],"key":"Ebv7nBokNq"},{"type":"text","value":": Obstetrics and Gynecology providers (OBGYNs) identified using NPPES taxonomy codes","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ifITQ9jdZc"}],"key":"v73t1UgFnB"}],"key":"sW18U3T978"}],"key":"qzSslik60c"},{"type":"heading","depth":3,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"GFF3JmYHa4"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"lbzfHOS49p"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Retrospective secondary data analysis using geographic information systems (GIS). Researchers geocoded OB/GYN provider locations and calculated driving distance (miles) and driving time (minutes) from population-weighted residential zip codes to nearest obstetric providers. They then employed generalized linear mixed models to examine associations between accessibility measures and five maternal/infant health outcomes, adjusting for individual factors (age, race/ethnicity, insurance type) and community-level factors (rural-urban classification, income segregation, racial segregation using the Index of Concentration at the Extremes). Geographic clustering was accounted for using random intercepts by residential ZCTA.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"aVGgNiabIu"}],"key":"OETwowiNFV"},{"type":"heading","depth":3,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"FOmdb98JfW"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"ir4TTs5sCj"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"The analysis included only OB/GYN providers and excluded other critical maternal healthcare providers—notably midwives and family physicians—who deliver approximately 10% of babies in rural settings. This omission may have overlooked a significant component of actual maternal care accessibility. Additionally, the NPI database relies on self-reported provider data, and providers may retire or relocate without updates, affecting accuracy. Importantly, socioeconomic factors—not race/ethnicity—emerged as the primary determinant of provider shortages in North Carolina, likely reflecting the state’s unique Appalachian geography and demographics; these findings may not generalize to other U.S. regions.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"AfnAfEwklm"}],"key":"WORZn9kEev"},{"type":"heading","depth":3,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"TcgMq9zLeL"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"yiuHV8iFvF"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/6vupzn4iwu2jzzl4gnhtc/The-Journal-of-Rural-Health-2025-Sugg-Mapping-maternity-care-deserts-Driving-distance-and-health-outcomes-in-North.pdf?rlkey=zia9y7p4vinyz5uc72q0lzuct&st=g5om58hn&dl=0","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"l5Ov77W0hw"}],"urlSource":"https://www.dropbox.com/scl/fi/6vupzn4iwu2jzzl4gnhtc/The-Journal-of-Rural-Health-2025-Sugg-Mapping-maternity-care-deserts-Driving-distance-and-health-outcomes-in-North.pdf?rlkey=zia9y7p4vinyz5uc72q0lzuct&st=g5om58hn&dl=0","key":"YWdJQyzOCz"},{"type":"text","value":" · DOI: ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"FrMdk4g3rK"},{"type":"cite","url":"https://doi.org/10.1111/jrh.70020","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Sugg ","key":"sLtv6VenoA"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"yOYWNElFaI"}],"key":"pjTTJvSkWC"},{"type":"text","value":" (2025)","key":"c8h5J3PkFH"}],"kind":"narrative","label":"Sugg_2025","identifier":"https://doi.org/10.1111/jrh.70020","enumerator":"2","key":"gDAkEPW1HT"}],"key":"J6DPc5kdrF"},{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"c9PSAhirQz"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"Puy61Bstfo"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"This study moves beyond county-level categorizations to map maternity care deserts at smaller geographic scales, linking provider accessibility directly to maternal outcomes. The findings are alarming: women traveling far to reach obstetric care experience substantially higher rates of dangerous complications including severe maternal morbidity. The research reveals that socioeconomic vulnerability—not just rurality—drives these disparities in North Carolina. Importantly, the study identifies specific health outcomes most sensitive to access barriers: severe maternal morbidity shows the strongest gradient, followed by cesarean delivery and preterm birth. These granular geospatial insights are critical for targeting interventions. The research also highlights that current policy lacks clear national standards for obstetric access (unlike stroke response time standards), leaving communities without benchmarks for adequate maternal healthcare infrastructure.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"YMIFICWSuy"}],"key":"agwJgVqqyF"}],"key":"h4cYbet7Ht"}],"key":"anhBvYm3uj"},"references":{"cite":{"order":["Sugg2025Mapping","Sugg_2025"],"data":{"Sugg2025Mapping":{"label":"Sugg2025Mapping","enumerator":"1","doi":"10.1111/jrh.70020","html":"Sugg, M., Shakya, S., Ulrich, S., Tyson, J. S., & Runkle, J. (2025). Mapping maternity care deserts: Driving distance and health outcomes in North Carolina. <i>The Journal of Rural Health</i>, <i>41</i>(2). <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1111/jrh.70020\">10.1111/jrh.70020</a>","url":"https://doi.org/10.1111/jrh.70020"},"Sugg_2025":{"label":"Sugg_2025","enumerator":"2","doi":"10.1111/jrh.70020","html":"Sugg, M., Shakya, S., Ulrich, S., Tyson, J. S., & Runkle, J. (2025). Mapping maternity care deserts: Driving distance and health outcomes in North Carolina. <i>The Journal of Rural Health</i>, <i>41</i>(2). <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1111/jrh.70020\">10.1111/jrh.70020</a>","url":"https://doi.org/10.1111/jrh.70020"}}}},"footer":{"navigation":{"prev":{"title":"Scope-of-practice regulations and PA inter-state relocation","short_title":"PA scope of practice and relocation","url":"/book/paper-notes/2025-01-01-pa-scope-interstate-relocation","group":"Publications"},"next":{"title":"Pharmacist prescriptive authority in Idaho","short_title":"Pharmacist prescribing Idaho","url":"/book/paper-notes/2024-06-01-pharmacist-idaho","group":"Publications"}}},"domain":"http://localhost:3000"}