:{"line":21,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"IsVeeazt97"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"fo21zteNQi"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Professor-sent email reminders to students scoring below 30 points on weekly assignments.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"AxjDvSvw6X"}],"key":"PzlArRFNFU"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"HHiE8trGO8"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"FiU4o5dvLU"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Email nudges improved low-performing student grades by 22-28 points per 50 points (44-56% improvement). Effect remained strong across 12 weeks despite some evidence of nudge fatigue with repeated treatments.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"duZkWPmyqy"}],"key":"qPC8W7qJIe"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"xTIl4rB9Ra"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"PdjVrhs0KS"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"80 consenting students across three sections of Principles of Macroeconomics, hybrid format, spring 2021 at Shippensburg University. Students received part-I and part-II assignments weekly, each worth 50 points. Email sent if part-I score below 30.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"eCm5o0VEt7"}],"key":"JDuI3qOghQ"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"EQm3ltfdbZ"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"lWvgi35gT9"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Difference-in-differences approach using observational data where treatment assignment was conditional on prior performance (part-I score). Exploited university power outages as natural experiment for robustness (triple difference-in-differences). Conducted 1,000 permutation tests to verify results were not due to chance.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"zOLS2WQn9O"}],"key":"xsenK7kOtI"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"wNHgYE7QU7"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"KpDXXaXJES"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Results based on observational, not randomized, data. Treatment effects specific to low-performing students and cannot be interpreted as average treatment effects for the population. Repeated nudges showed diminishing returns (22-28 points for one nudge vs. 24 points after four nudges), suggesting saturation effects.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"EHeLWganbx"}],"key":"LL4YktQEBF"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"BjZBi2ADn9"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"IktYXh09mg"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/o9seuixtlkn74xdnzljcw/Grading-policy-email-nudges-and-grade-outcomes.pdf?rlkey=i1k0jzv8h55txa5625x35ik1g&dl=0","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"haqiNbxtH2"}],"urlSource":"https://www.dropbox.com/scl/fi/o9seuixtlkn74xdnzljcw/Grading-policy-email-nudges-and-grade-outcomes.pdf?rlkey=i1k0jzv8h55txa5625x35ik1g&dl=0","key":"URjF5BvYPW"}],"key":"oZU0xn7nzj"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"yIr1zhuwAP"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"dF2DrsLR8v"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Prior studies on email nudges in higher education show mixed results. This paper demonstrates substantial effects when nudges target low performers specifically. The 22-28 point improvement is large compared to other programs, suggesting cost-effective reminders could improve retention and academic performance, particularly for struggling students.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"n4SR9T9gzg"}],"key":"EmlEAfyr5s"}],"key":"B1ZkHjDUeN"}],"key":"MEcoL58jsx"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Hospital ownership changes and charge-to-cost shifts","short_title":"Hospital ownership and charges","url":"/book/paper-notes/2024-01-01-hospital-ownership-charge-cost","group":"Publications"},"next":{"title":"Anti-maintenance of certification and elderly physician supply","short_title":"Anti-MOC and physician supply","url":"/book/paper-notes/2024-01-01-anti-moc-elderly-physician-supply","group":"Publications"}}},"domain":"http://localhost:3000"}