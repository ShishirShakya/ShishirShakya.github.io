{"version":3,"kind":"Article","sha256":"acb9fcd1baa61caef8e8e40fc86bfc63741234e3dddca2aa09620913f93d644d","slug":"book.paper-notes.2024-01-01-grading-policy-email-nudges","location":"/book/paper-notes/2024-01-01-grading-policy-email-nudges.md","dependencies":[],"frontmatter":{"title":"Grading policy, email nudges, and grade outcomes","description":"Email reminders to low-performing students improved exam scores by 22-28 points out of 50, a 44-56 percent improvement.","short_title":"Grading policy and nudges","tags":["education","policy","teaching-and-learning"],"date":"2024-01-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2024-01-01-grading-policy-email-nudges.md","url":"/build/2024-01-01-grading-p-9a99a86d2e77515b67670989d4afee6e.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"pymtOtwES0"}],"key":"MOlR3QqV2L"},{"type":"text","value":": ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"YBGmQ44dPo"},{"type":"inlineCode","value":"shakya-2024-grading-policy-email-nudges","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"txmmxmIO6d"},{"type":"break","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"fbmJXflmNo"},{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"htTGA1HwMc"}],"key":"T11WTut6UE"},{"type":"text","value":": verified","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Yoah1pZ9bN"}],"key":"ra8B0IeKG3"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"il2kCzESox"}],"key":"vPf9mSpVxg"},{"type":"text","value":": Shakya, S., & Levinstein, M. (2024). Grading policy, email nudges, and grade outcomes. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"p11kwTTD6P"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The Journal of Economic Education","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"npmisxrhdY"}],"key":"wQNCgD63ho"},{"type":"text","value":". ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"vEPIBX3Qka"},{"type":"link","url":"https://www.dropbox.com/scl/fi/o9seuixtlkn74xdnzljcw/Grading-policy-email-nudges-and-grade-outcomes.pdf?rlkey=i1k0jzv8h55txa5625x35ik1g&dl=0","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"K5zLOh8mW5"}],"urlSource":"https://www.dropbox.com/scl/fi/o9seuixtlkn74xdnzljcw/Grading-policy-email-nudges-and-grade-outcomes.pdf?rlkey=i1k0jzv8h55txa5625x35ik1g&dl=0","key":"MMBkQtY6ts"}],"key":"enhvL9fYSc"},{"type":"heading","depth":2,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"lyopvBQVYs"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"O6MtD0vO9F"},{"type":"heading","depth":3,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"oyrNKo4Nem"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"AMrCIxLfCp"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Professor-sent email reminders to students scoring below 30 points on weekly assignments.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Hrib6s9JCj"}],"key":"LPsejeVZTK"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"JPu8hf0fo7"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"xVFBUcm7A2"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Email nudges improved low-performing student grades by 22-28 points per 50 points (44-56% improvement). Effect remained robust across 12 weeks despite some evidence of nudge fatigue with repeated treatments.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"CGp2dRxhYI"}],"key":"oUc7UtE45x"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"JChnsMALRn"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"iCVk2UtvGu"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"80 consenting students across three sections of Principles of Macroeconomics, hybrid format, spring 2021 at Shippensburg University. Students received part-I and part-II assignments weekly, each worth 50 points. Email sent if part-I score below 30.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"cQJzPfEpH2"}],"key":"htHzUfAHK7"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"BkZRY6ZJts"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"A5dupZbHuP"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Difference-in-differences approach using observational data where treatment assignment was conditional on prior performance (part-I score). Exploited university power outages as natural experiment for robustness (triple difference-in-differences). Conducted 1,000 permutation tests to verify results were not due to chance.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"qpJ1VMX5Jx"}],"key":"yJ1Ja5GXJ3"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"zQwi1WSdvM"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"tzynMoxE2u"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Results based on observational, not randomized, data. Treatment effects specific to low-performing students and cannot be interpreted as average treatment effects for the population. Repeated nudges showed diminishing returns (22-28 points for one nudge vs. 24 points after four nudges), suggesting saturation effects.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"ewlZDvUGkW"}],"key":"QvBc9D1Nh4"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"i5w2SaIEZ5"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"ueoa3sRjGI"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/o9seuixtlkn74xdnzljcw/Grading-policy-email-nudges-and-grade-outcomes.pdf?rlkey=i1k0jzv8h55txa5625x35ik1g&dl=0","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"PBHeun4A8S"}],"urlSource":"https://www.dropbox.com/scl/fi/o9seuixtlkn74xdnzljcw/Grading-policy-email-nudges-and-grade-outcomes.pdf?rlkey=i1k0jzv8h55txa5625x35ik1g&dl=0","key":"UqqJisci52"}],"key":"ByAVrNnODK"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"FkJnGYu7VW"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"rOcXW77Hdy"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Prior studies on email nudges in higher education show mixed results. This paper demonstrates substantial effects when nudges target low performers specifically. The 22-28 point improvement is large compared to other interventions, suggesting cost-effective reminders could improve retention and academic performance, particularly for struggling students.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"UtBYhyoBvJ"}],"key":"fw7YZ6tuKG"}],"key":"N74HsoRT46"}],"key":"MG7azyR3mp"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Hospital ownership changes and charge-to-cost shifts","short_title":"Hospital ownership and charges","url":"/book/paper-notes/2024-01-01-hospital-ownership-charge-cost","group":"Publications"},"next":{"title":"Anti-maintenance of certification and elderly physician supply","short_title":"Anti-MOC and physician supply","url":"/book/paper-notes/2024-01-01-anti-moc-elderly-physician-supply","group":"Publications"}}},"domain":"http://localhost:3000"}