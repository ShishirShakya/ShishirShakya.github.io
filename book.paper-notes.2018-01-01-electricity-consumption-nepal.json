ype":"text","value":"Nepal economic data; time-series analysis examining relationship between electricity consumption and economic growth in a resource-rich landlocked developing economy.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"tmlzCwE5CG"}],"key":"wdmKJ3watX"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"XeFLwTVzNa"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"jab74pIXuF"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Time-series econometric analysis examining the dynamic relationship between electricity consumption and economic growth in Nepal’s specific development context.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"AGdupWlGgs"}],"key":"HzuLE01Hyp"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"AgIbO4Ri8l"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"srKaxtD1HS"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Time-series analysis cannot establish causality definitively and may conflate electricity’s role with other development factors simultaneously driving growth.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"vv1lPIvjhw"}],"key":"c4B4rlegTt"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"qdF4ChirNM"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"GjvIJ5kPjB"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://www.inderscience.com/offers.php?id=97139","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Publisher page","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"ZmMs4j8kuz"}],"urlSource":"https://www.inderscience.com/offers.php?id=97139","key":"fS83X3jkPh"}],"key":"jxe3QrhxP2"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"qnRIko1alC"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"ynS7K65hee"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Energy scarcity is a binding constraint on development in many low-income countries, especially landlocked economies without fossil fuels. This paper documents a positive relationship between electricity availability and growth in Nepal—a high-altitude, landlocked country where hydropower is both abundant and underdeveloped. For Nepal specifically, the finding supports hydroelectric investment as a development priority. For other resource-rich developing countries, the result suggests that energy infrastructure is complicit in growth: electricity enables productivity gains across sectors. The time-series approach captures dynamic relationships but cannot isolate causality—growth may increase demand for electricity rather than electricity driving growth. For policymakers, the paper validates prioritizing electricity access in development strategies, though the mechanism (productivity, consumption, investment) remains to be clarified. The work also provides a developing-country perspective on energy-growth relationships, complementing research on high-income countries where electricity is abundant and relationships may differ.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"eOt2eb5frA"}],"key":"I84nSqwX68"}],"key":"GrM3z1r5Xl"}],"key":"hTTTYvNbcH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Federal regulations and US energy sector output","short_title":"Federal regulations and energy","url":"/book/paper-notes/2019-01-01-federal-regulations-energy-output","group":"Publications"},"next":{"title":"Quotas and reservations to ensure equity in Nepal","short_title":"Nepal quotas and equity","url":"/book/paper-notes/2016-01-01-nepal-quotas-reservations-equity","group":"Publications"}}},"domain":"http://localhost:3000"}