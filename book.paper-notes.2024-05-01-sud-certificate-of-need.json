{"version":3,"kind":"Article","sha256":"eb13c4b639456413f19888b6f9a0813259afceaef5867ee57046265a7a94ce96","slug":"book.paper-notes.2024-05-01-sud-certificate-of-need","location":"/book/paper-notes/2024-05-01-sud-certificate-of-need.md","dependencies":[],"frontmatter":{"title":"Substance use Certificate-of-Need laws and treatment access","description":"Certificate-of-Need laws reduce spatial accessibility to substance use treatment by 10 percent, with larger effects for medications like buprenorphine.","short_title":"SUD Certificate-of-Need","tags":["substance-use","certificate-of-need","policy","access-to-care"],"date":"2024-05-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2024-05-01-sud-certificate-of-need.md","url":"/build/2024-05-01-sud-certi-859c96870acf71f09bb5f1f49acf8ee7.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Wdcyvtd3Rj"}],"key":"LLGvFoSKze"},{"type":"text","value":": ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"HBQGdv22u3"},{"type":"inlineCode","value":"shakya-2024-sud-certificate-of-need","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"fp9nzM0fDy"},{"type":"break","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"xohFsyZKM8"},{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"R4TUCAaMwu"}],"key":"X4dNGGbQOp"},{"type":"text","value":": verified","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"xfJWA884y1"}],"key":"QGvHVPDv9a"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"xxRVnk61kJ"}],"key":"gw1pSDNZNH"},{"type":"text","value":": Shakya, S., & Bretschneider Fries, C. (2024). The effect of substance use Certificate-of-Need laws on access to substance use disorder treatment facilities. ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"zk5ThqVrte"},{"type":"emphasis","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Southern Economic Journal","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"AR9NE5CJRR"}],"key":"g0FJsVkoKn"},{"type":"text","value":". ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"hzGdHhJc74"},{"type":"link","url":"https://www.dropbox.com/scl/fi/fkhpvcf0ico3xjxjcs66b/Southern-Economic-Journal-2024-Shakya-The-effect-of-substance-use-Certificate-of-Need-laws-on-access-to-substance-use.pdf?rlkey=lapu9zmq0x9gwe362ttpeailb&dl=0","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"vSv1gJoZdW"}],"urlSource":"https://www.dropbox.com/scl/fi/fkhpvcf0ico3xjxjcs66b/Southern-Economic-Journal-2024-Shakya-The-effect-of-substance-use-Certificate-of-Need-laws-on-access-to-substance-use.pdf?rlkey=lapu9zmq0x9gwe362ttpeailb&dl=0","key":"cOaA2iBnKl"}],"key":"Tkw3nyBgoG"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"H9xomIXMUr"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"x865Qj8PUA"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"uxnQXDBNua"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"kYRWBOIyju"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Do Certificate-of-Need (CON) laws, which require healthcare providers to prove regulatory necessity before expanding services, help or harm access to substance use disorder treatment facilities? These laws aim to prevent wasteful spending but critics argue they create barriers to entry and reduce access to care.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"Fpv4hLT8gt"}],"key":"wIXu0KaOCc"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"zXqRYmL4tl"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"LpG7KSghi8"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Counties in states with CON laws that border counties without CON laws have approximately 10 percent less spatial accessibility to substance use disorder treatment facilities. For services like buprenorphine and naltrexone, border counties with CON laws showed 6-11 percent lower access, while federally-certified opioid treatment programs showed 6 percent higher access.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"qbJpQECSpU"}],"key":"mwIrlTAEkC"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"LaT6L3B8xX"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"vAbi7of3Da"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"2020 data from the National Directory of Drug and Alcohol Abuse Treatment Facilities, identifying 12,018 unique opioid-related treatment facilities across 3,143 counties. As of 2020, 23 U.S. states had CON laws for substance use treatment. Analysis used facility coordinates and measured driving distance and time from population-weighted county centroids.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"X9kdjTyv83"}],"key":"ArMl4Nw8sH"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"fzxhyi7xMV"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"vBPajrwem6"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Spatial accessibility index based on driving distance and duration to nearest treatment facilities, accounting for travel impedance and facility capacity. Border comparison framework similar to difference-in-differences but replacing time dimension with border identifier, comparing border counties in CON states versus border counties in non-CON states to control for unobservable state-level factors. Applied inverse hyperbolic sine transformation to facilitate interpretation as percentage changes.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"lonhBTiJRZ"}],"key":"saAd32yv1W"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"biNMiubJMf"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"V4NDARDFMH"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The study measures spatial proximity to treatment facilities but does not account for the actual availability of specific services at those facilities or the capacity of facilities to serve patients. Limited to 2020 data, which may not reflect current conditions given that some states modified or repealed CON laws during the COVID-19 pandemic.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"h0Tn7Ewr2U"}],"key":"dRUYQY5Ytk"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"YAjI29I52I"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"qawKJ14Y3i"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/fkhpvcf0ico3xjxjcs66b/Southern-Economic-Journal-2024-Shakya-The-effect-of-substance-use-Certificate-of-Need-laws-on-access-to-substance-use.pdf?rlkey=lapu9zmq0x9gwe362ttpeailb&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"L9ehwVhTzn"}],"urlSource":"https://www.dropbox.com/scl/fi/fkhpvcf0ico3xjxjcs66b/Southern-Economic-Journal-2024-Shakya-The-effect-of-substance-use-Certificate-of-Need-laws-on-access-to-substance-use.pdf?rlkey=lapu9zmq0x9gwe362ttpeailb&dl=0","key":"vSPvVcVla9"}],"key":"S4MVJLLfie"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"TElsKoDSDN"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"Q9Fjrznj8s"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Geographic distance to treatment is critical for substance use disorder recovery success. People with substance use disorders often face additional barriers including financial and transportation constraints. CON laws were designed to prevent wasteful healthcare spending, but this evidence shows they reduce access to treatment precisely when the opioid crisis demands expanded treatment capacity. The study reveals unintended consequences of supply-side regulations on a population already facing significant obstacles to recovery. Understanding these regulatory effects is essential for policymakers addressing the opioid epidemic and ensuring treatment accessibility for those seeking help.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"kkjl3DSPb5"}],"key":"Kh1HlgwCoI"}],"key":"SRQGBluw93"}],"key":"fZbh15e6PE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Pharmacist prescriptive authority in Idaho","short_title":"Pharmacist prescribing Idaho","url":"/book/paper-notes/2024-06-01-pharmacist-idaho","group":"Publications"},"next":{"title":"Firm responsiveness to environmental policy in shale production","short_title":"Shale and environmental policy","url":"/book/paper-notes/2024-01-01-shale-environmental-policy","group":"Publications"}}},"domain":"http://localhost:3000"}