"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"A 10% improvement in access to mental health providers reduces suicide rates by 3% (1.6 fewer suicides per 100,000 population). This equals approximately 3 additional mental health providers per mile in a county.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"oLhvGuhp4a"}],"key":"ptnH1yzsVe"},{"type":"heading","depth":3,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"jdaTrA6OHy"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"fKxs1niy7i"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"County-level panel data from 2016-2019 tracking the universe of psychiatric and psychological practice locations across all US counties using National Provider Enumeration System data. Suicide rates from CDC Wonder database.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"bHuKsRoXWM"}],"key":"GZ5vtcgy2M"},{"type":"heading","depth":3,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"KSc6eNoCqT"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"NBi7sSuWSL"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Instrumental variable approach using state implementation of psychologist prescriptive authority (RxP) laws as an exogenous instrument to address endogeneity between provider location and suicidality. Two-stage least squares regression with arcsinh-arcsinh specification on 12,556 county-year observations.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"djHwlFGH9w"}],"key":"dgNP0EpU9z"},{"type":"heading","depth":3,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"yhRwhYMpYN"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"X2AzKDFtXg"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Results show complementarity between psychologists and psychiatrists. When isolating only psychologist supply, effects become statistically insignificant. Treatment effects represent local average treatment effects (LATE) for those affected by RxP laws, limiting generalizability beyond states with similar regulatory variation.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"xFw3qPD3wk"}],"key":"PF3toBTIRB"},{"type":"heading","depth":3,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"cIMA38kWTG"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"r6mIaMO2tl"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/99w08a9akb5vjf1k04ffe/Access-to-Mental-Health-Care-Services-and-Suicide-Rates-in-the-United-States.pdf?rlkey=8g8o5yqhd95o20c9pvzth7npu&st=grdkwgzq&dl=0","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":