:{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"PmLLQwoRJt"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"NcsnysHBcp"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Vermont state legislative process and policy analysis around abortion bill; applied economics letters publication.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"T8DbcjVfgw"}],"key":"nhi147WTRz"},{"type":"heading","depth":4,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"uYLbWgc1OW"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"aVMHONHlBF"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Political-economy analysis examining legislative context, positions of those involved, and economic interests affecting abortion policy development in Vermont.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"ryzzgYQ7Lg"}],"key":"mBb9bEdWTj"},{"type":"heading","depth":4,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"YxTcHfRxL7"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"x7GSM8jxmD"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Case study approach focused on single state limits external validity to other jurisdictions with different political and economic configurations.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"iQxSkFWPaO"}],"key":"sug9Owhx3B"},{"type":"heading","depth":4,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"zo0NDVBv94"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"vclrwPMqcp"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"cite","url":"https://www.tandfonline.com/doi/abs/10.1080/13504851.2020.1854663","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Publisher page","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"XY3Pga2foW"}],"kind":"narrative","label":"Shakya_2020","identifier":"https://www.tandfonline.com/doi/abs/10.1080/13504851.2020.1854663","enumerator":"1","key":"DDPKOdoRzM"}],"key":"movARXHfXQ"},{"type":"heading","depth":3,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"AEC1rg9XWV"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"SLmjYVqjdi"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Abortion policy is fiercely debated, but political economy analysis - examining interest groups and political incentives - offers a different lens than purely moral or constitutional arguments. This paper’s focus on Vermont’s specific bill reveals the political dynamics of state-level abortion policy. Vermont is instructive because it’s a liberal state with strong abortion access norms, suggesting policy emerges from particular political configurations. For political scientists, the case shows how interest groups, legislative coalitions, and state-level institutional features combine to shape reproductive policy. For policy makers and advocates, the paper shows the political economy of feasible policy: what coalition building enabled Vermont’s policy? Could it replicate elsewhere? For comparative policy study, Vermont provides a northern state case (contrast with Southern states’ restrictions), showing that state politics, not just national conservatism/liberalism, drives abortion policy. The limitation (single case) restricts generalization, but Vermont’s relative policy stability makes it a useful reference point.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"lRJzDXpxs3"}],"key":"hMQohNWriF"}],"key":"cNeKb9so2H"}],"key":"e9y7Bj18ZR"},"references":{"cite":{"order":["Shakya_2020"],"data":{"Shakya_2020":{"label":"Shakya_2020","enumerator":"1","doi":"10.1080/13504851.2020.1854663","html":"Shakya, S., Erfanian, E., & Scarcioffolo, A. (2020). The political economy of Vermont’s abortion bill. <i>Applied Economics Letters</i>, <i>29</i>(1), 17–21. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1080/13504851.2020.1854663\">10.1080/13504851.2020.1854663</a>","url":"https://doi.org/10.1080/13504851.2020.1854663"}}}},"footer":{"navigation":{"prev":{"title":"Political economy of Vermont's anti-fracking movement","short_title":"Vermont anti-fracking","url":"/book/paper-notes/2020-01-01-vermont-anti-fracking","group":"Publications"},"next":{"title":"Replication of Bersani and Doherty 2013","short_title":"Bersani-Doherty replication","url":"/book/paper-notes/2020-01-01-score-bersani-doherty-replication","group":"Publications"}}},"domain":"http://localhost:3000"}