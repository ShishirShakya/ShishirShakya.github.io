"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"E9fQYFxRRI"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"a0bfGJndFT"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Economic freedom influences entrepreneurship, but prior studies showed only correlations. Which specific dimensions of economic freedom - regulatory, tax, or spending - actually causally increase new business formation?","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Yuso9KBtEx"}],"key":"UO1g9DcpGv"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"rz5nT11qdb"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"zEbPupahHA"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Regulatory freedom significantly increases startup density, while increases in government spending and tax freedom actually decrease startup formation, revealing that business deregulation drives entrepreneurship.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"BXUsuJyYvr"}],"key":"ProNLaMSoB"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"NlNbQMqnGa"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"asVRccsmQx"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"U.S. data 2005-2015 using Kauffman Startup Activities Index (startup density: firms under one year old employing workers) and Economic Freedom of North America index.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"YHo3R6oQIX"}],"key":"zZbVcYW4SR"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"KIfBKsKrtb"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"aPXduZNprE"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Post-double-selection LASSO methodology identified causal effects among multiple dimensions of economic freedom while controlling for relevant covariates.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"DlTMidJibq"}],"key":"MyGv8IwpjA"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"xFBbwmPrYT"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"Vyq0Hq4CN0"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Analysis focuses on startup density but does not measure startup quality, survival rates, or employment creation by new ventures.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"YnjqlEbtLI"}],"key":"eYMroYtJRJ"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"X7TkiJDZy9"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"v3IQK5722K"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://jrap.scholasticahq.com/article/18968-the-impact-of-economic-freedom-on-startups/attachment/50505.pdf","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"oE1TIN78MV"}],"urlSource":"https://jrap.scholasticahq.com/article/18968-the-impact-of-economic-freedom-on-startups/attachment/50505.pdf","key":"GRh2lrEkAh"}],"key":"KE3mx2Pibz"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"bWVGJUtnci"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"imNQbtt1Ay"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Entrepreneurship is central to prosperity. This paper shows that the specific dimensions of economic freedom matter - deregulation drives startups, but high taxes and large government spending actually reduce new business formation. For policy makers seeking to boost entrepreneurship, the finding narrows the target: focus on regulatory barriers (licensing, permitting, compliance costs), not just general “pro-business” rhetoric. The result complicates libertarian arguments that all government spending reduces enterprise; the mechanism is more specific. For states and municipalities competing on business climate, the paper suggests that startup-friendly policy means low regulatory burden plus competitive tax treatment, even if overall government spending is high (since some spending may support infrastructure or stability startups need). The null effect of tax freedom alone is also noteworthy: very low taxes without regulatory relief don’t translate to startup booms. This implies that regulatory burden is the primary bottleneck for new firm entry.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"TYP7Q668aH"}],"key":"OiAopTDWFc"}],"key":"TeX5t1fdI5"}],"key":"J3BvVMQ22A"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"The fracking boom and crime rates in rural American states","short_title":"Fracking and rural crime","url":"/book/paper-notes/2021-01-01-fracking-boom-rural-crime","group":"Publications"},"next":{"title":"Temporal actions under uncertainty in crowdfunding campaigns","short_title":"Crowdfunding and timing","url":"/book/paper-notes/2021-01-01-crowdfunding-temporal-actions","group":"Publications"}}},"domain":"http://localhost:3000"}