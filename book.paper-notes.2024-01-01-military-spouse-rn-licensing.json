[{"type":"text","value":"Military nurses near U.S. military bases; state-level licensing policy reforms for military spouses in the 2010s.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"CcjMjBo4bj"}],"key":"WdtWOu8izM"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"ZFfCOcmcnG"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"ODxHVViW2U"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Comparative analysis of military spouse licensing reforms examining how policy changes affect nurse retention and geographic flexibility.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"CPniJXtmws"}],"key":"NYIbbWBpmA"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"sG4qIv23hI"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"I8ss0W6dSj"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Suggestive evidence presented; does not isolate other factors driving military spouse employment decisions or retention like spouse income or family considerations.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"yqCnIeWMMu"}],"key":"RoAROyU2C7"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"nhIFJsWira"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"pcNQlRb6b5"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"cite","url":"https://link.springer.com/article/10.1007/s11149-024-09480-7","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Publisher page","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"N9UFXyDruG"}],"kind":"narrative","label":"Shakya_2024","identifier":"https://link.springer.com/article/10.1007/s11149-024-09480-7","enumerator":"1","key":"ChGq9hvaza"}],"key":"xPA3M7lyoD"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"poJWVy5I5Y"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"doWVVTcIwt"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Military families face unique constraints: frequent relocations are mandatory, not optional. Spouses can’t simply stay in one location to maintain employment. Restrictive state licensing prevents military spouses from practicing their profession, forcing career interruptions. This paper shows that licensing reciprocity directly improves employment outcomes—a 12% increase in mobility is substantial. For military families, career continuity affects retention, quality of life, and household finances. For the military itself, quality-of-life initiatives like spouse employment support reduce attrition of valuable personnel. For policymakers, the finding illustrates a simple win: reciprocal military-spouse licensing costs states nothing but enables federal personnel retention. The broader implication is that occupational licensing—designed to protect consumers—can inadvertently create inequality when it prevents geographic mobility for constrained populations. Exempting military spouses or allowing conditional reciprocity is a targeted policy with measurable benefits.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"F5ryttHr03"}],"key":"xcFQzMQ0ar"}],"key":"poX8yKHTXR"}],"key":"Wzf2HgUI3J"},"references":{"cite":{"order":["Shakya_2024"],"data":{"Shakya_2024":{"label":"Shakya_2024","enumerator":"1","doi":"10.1007/s11149-024-09480-7","html":"Shakya, S., Plemmons, A., & Norris, C. (2024). Military spouse licensing: a case study of registered nurses near military bases. <i>Journal of Regulatory Economics</i>, <i>66</i>(2–3), 135–156. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1007/s11149-024-09480-7\">10.1007/s11149-024-09480-7</a>","url":"https://doi.org/10.1007/s11149-024-09480-7"}}}},"footer":{"navigation":{"prev":{"title":"Nurse practitioner scope of practice and opioid prescribing","short_title":"NP scope and opioid prescribing","url":"/book/paper-notes/2024-01-01-np-sop-opioid-prescribing","group":"Publications"},"next":{"title":"Hospital ownership changes and charge-to-cost shifts","short_title":"Hospital ownership and charges","url":"/book/paper-notes/2024-01-01-hospital-ownership-charge-cost","group":"Publications"}}},"domain":"http://localhost:3000"}