{"version":3,"kind":"Article","sha256":"985c7592bb76831cd2ef70ac53f4b6a56c9bf612f50f2e67a4910ea19fd31bb2","slug":"book.paper-notes.2022-01-01-must-access-pdmp-retail-opioids","location":"/book/paper-notes/2022-01-01-must-access-pdmp-retail-opioids.md","dependencies":[],"frontmatter":{"title":"Must-access PDMPs and retail opioid sales","description":"Must-access PDMP policies reduce retail sales of some opioids (hydrocodone, morphine) but not others (oxycodone); effects vary by drug type.","short_title":"Must-access PDMP and opioids","tags":["substance-use","opioids","policy","regulation"],"date":"2022-01-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2022-01-01-must-access-pdmp-retail-opioids.md","url":"/build/2022-01-01-must-acce-03f4b60a0b73042b4799c9cb740c02da.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"DHAMb1AOgk"}],"key":"b4YTcJXgZH"},{"type":"text","value":": ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"oZEQubJZ9n"},{"type":"inlineCode","value":"shakya-2022-must-access-pdmp-retail-opioids","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"IYB0yrEnrE"},{"type":"text","value":"\n","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Rrw1g7gBpz"},{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Khj07AZq1v"}],"key":"EEmYsHu296"},{"type":"text","value":": verified","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"EBs78fSq0a"}],"key":"FC8brUHDct"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"waVpBkpdhz"}],"key":"GkfXz9kW6s"},{"type":"text","value":": Shakya, S., & Hodges, C. (2022). Must access prescription drug monitoring programs and retail opioid sales. ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"mq0RvUD10X"},{"type":"emphasis","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Contemporary Economic Policy","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"JGZ7WYsiHg"}],"key":"aLOftxtYAv"},{"type":"text","value":". ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"obwu7mWbBw"},{"type":"link","url":"https://www.dropbox.com/scl/fi/d2yash55gkz0j8wvkn61o/Contemporary-Economic-Policy-2022-Shakya-Must-access-prescription-drug-monitoring-programs-and-retail-opioid-sales.pdf?rlkey=zno0w3llwq2i5kz1ioivdrogo&dl=0","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"raNcouwj0q"}],"urlSource":"https://www.dropbox.com/scl/fi/d2yash55gkz0j8wvkn61o/Contemporary-Economic-Policy-2022-Shakya-Must-access-prescription-drug-monitoring-programs-and-retail-opioid-sales.pdf?rlkey=zno0w3llwq2i5kz1ioivdrogo&dl=0","key":"cuB4uofTgd"}],"key":"HetkFnBL7m"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"r5ZwLDipzc"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"Qei440bpF4"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"JJoeOPsmLg"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"BGGDryCgKL"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"PDMPs are state-level electronic databases tracking controlled-substance fills, intended to curb opioid abuse and overprescribing. Most states started with voluntary access, but many transitioned to “must-access” mandates requiring prescribers to check the database before dispensing. The question is whether must-access rules actually reduce retail opioid sales, and whether effects differ across opioid types.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"CBVc2nVYve"}],"key":"zm8g0dRHZ6"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"gfHPJnI6J2"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"s0WHW66kva"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Must-access PDMP implementation does not uniformly reduce retail opioid sales. Certain opioids show sales declines: hydrocodone, hydromorphone, and morphine all decrease after must-access adoption. However, oxycodone - the most widely prescribed opioid - shows no statistically significant change. Methadone and buprenorphine (medications for opioid use disorder treatment) also remain unaffected. Effects are heterogeneous across drug types.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"tCaIGatHlT"}],"key":"HrIB607NLw"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"QCJoL9G2Ty"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"ageu59hfAP"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"ARCOS database (Drug Enforcement Administration opioid sales tracking), 2006-2017, covering eight commonly prescribed opioids tracked at the state-year level. Eighteen states implemented must-access PDMP mandates during the study period; remaining states kept voluntary access throughout (except Missouri, which had no statewide PDMP). Outcome is total retail opioid sales by drug type and state-year.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"alVaWo4lQo"}],"key":"POFemPTNu7"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"wRTvFOF7qa"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"uwGAr4k0Td"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"The paper uses difference-in-differences estimation with an interactive fixed effects model (Bai 2009) to account for unobserved time-varying confounders and non-linear state-specific trends. Controls include Good Samaritan laws, marijuana legalization, naloxone access laws, pill mill laws, Medicaid expansion, and state social and economic variables. The design exploits staggered adoption of must-access mandates across states.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"WB1iJEenCG"}],"key":"MmpI5qNmYE"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"wLWNV8a9de"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"kmEmZUZaWo"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Treatment effects are not uniform across opioid types, suggesting heterogeneous responses by prescriber behavior and patient demand. The analysis cannot explain why oxycodone is unaffected while other opioids decline. Policy makers should treat must-access PDMPs as one part of a wider opioid response rather than as a singular policy solution.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"SIqN62QuiA"}],"key":"imiU4fisOT"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"zVcNZgLz6g"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"RR7qeKTsFX"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/d2yash55gkz0j8wvkn61o/Contemporary-Economic-Policy-2022-Shakya-Must-access-prescription-drug-monitoring-programs-and-retail-opioid-sales.pdf?rlkey=zno0w3llwq2i5kz1ioivdrogo&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"SBxgysXkop"}],"urlSource":"https://www.dropbox.com/scl/fi/d2yash55gkz0j8wvkn61o/Contemporary-Economic-Policy-2022-Shakya-Must-access-prescription-drug-monitoring-programs-and-retail-opioid-sales.pdf?rlkey=zno0w3llwq2i5kz1ioivdrogo&dl=0","key":"PZUVkTq15p"}],"key":"LcN980S0Jp"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"yZv6zh37vz"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"Eb8pL9dqT3"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Must-access PDMPs are a frequently implemented policy response to opioid overprescribing, yet evidence on their effectiveness at the retail sales level has been limited. This paper shows that must-access mandates reduce sales of some opioids but not others - a finding with important consequences for policy design. The fact that oxycodone sales remain unaffected despite being the most widely prescribed opioid suggests that prescriber behavior or demand is not uniformly responsive to database checking requirements. This variation across drugs raises questions about what drives differential responses and whether prescribers are substituting toward less-regulated medications. For policy makers, the heterogeneous effects suggest that must-access PDMPs are a necessary but insufficient policy tool. They should be paired with other programs (education, prescriber feedback, naloxone distribution, treatment access) to achieve meaningful reductions across all opioid types. The work also highlights the importance of disaggregating policy results by drug type rather than treating opioids as a uniform category.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"S7vyh5WQTi"}],"key":"tdahimF0LX"}],"key":"uvuu6ddnOi"}],"key":"znYJKGZLTm"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Natural disasters and labor migration in Nepal","short_title":"Nepal earthquake and migration","url":"/book/paper-notes/2022-01-01-nepal-earthquake-labor-migration","group":"Publications"},"next":{"title":"Medicaid expansion and opioid supply policies","short_title":"Medicaid expansion and opioids","url":"/book/paper-notes/2022-01-01-medicaid-expansion-opioid-supply","group":"Publications"}}},"domain":"http://localhost:3000"}