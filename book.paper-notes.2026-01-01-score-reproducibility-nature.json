{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"cZbdOJOIrd"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"fhQOBztepQ"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Beyond replicability (can results be reproduced with new data?), reproducibility (can analyses be reproduced from original data?) matters for assessing research reliability. How reproducible are social and behavioral science analyses?","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"klsIIILgyb"}],"key":"qVwaDTWUCY"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"Gj7PhTItzv"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"SfzdR0sKDT"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Systematic assessment of reproducibility in social and behavioral sciences examines whether published analyses can be reproduced from original datasets and code.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"VFjNRgarMQ"}],"key":"syQ55HnnPm"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"a2kdBofZ6V"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"kLjZ4vuLRK"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Reproducibility project examining code and data availability for published studies in social and behavioral sciences; Varieties of Democracy and related databases.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"m3JWiScjEf"}],"key":"LG5SjxA9PX"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"cuGSB1eD8U"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"SNVMLok5sM"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Systematic audit of published papers assessing whether researchers can reproduce original analyses using available code, data, and documentation.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"ewbGYTVemr"}],"key":"LsZkuG6VFR"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"wt0gObjam5"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"GddqdJcy1C"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Reproducibility assessment requires researcher effort and cooperation; some failures may reflect inadequate documentation rather than fundamental analytical errors.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"IT607qoJ3m"}],"key":"tzI7deTmpk"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"S3y8MEH2OV"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"YBYTMAWPl6"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"https://repository.essex.ac.uk/42891/1/SCOREreproducibility.fullmanuscript.pdf","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"VMTPb3Id7b"}],"urlSource":"https://repository.essex.ac.uk/42891/1/SCOREreproducibility.fullmanuscript.pdf","key":"rysETpA9h8"}],"key":"gzO0WsXIiq"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"LhZlOnZVz0"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"rsomUCd91f"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Reproducibility is a basic principle of science: others should be able to verify published analyses by running the same code on the same data. Yet many published papers lack available data or code, making verification impossible. This systematic audit of reproducibility in social and behavioral science is needed because policy often relies on these findings - if analyses can’t be verified, confidence in policy is undermined. For researchers, the audit provides accountability: shared data and code enable peer scrutiny and build trust. For funding agencies and journals, reproducibility measures can inform publication standards and funding priorities. For policy makers, the results indicate which studies’ findings can be independently verified. The finding that many analyses lack reproducibility doesn’t necessarily discredit results - missing data might reflect privacy concerns or institutional constraints - but it does signal the need for transparency standards. Open science practices (data sharing, code availability) directly enable reproducibility. Combining reproducibility assessment (can analyses be verified?) with replicability testing (do new data confirm results?) gives a complete evidence quality picture.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"adUpCKyGJU"}],"key":"Rx707Ndk7b"}],"key":"UOefguwcWb"}],"key":"K4n6xEkCuB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Athletic reclassification and local entrepreneurial ecosystems","short_title":"Town, gown, and touchdowns","url":"/book/paper-notes/2026-01-01-town-gown-touchdowns","group":"Publications"},"next":{"title":"Investigating replicability in the social and behavioral sciences","short_title":"SCORE replicability","url":"/book/paper-notes/2026-01-01-score-replicability-nature","group":"Publications"}}},"domain":"http://localhost:3000"}