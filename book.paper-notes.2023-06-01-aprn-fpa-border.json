ine":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Related policy writing","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"GnzanErf5n"}],"key":"Pz4BIVrRHq"},{"type":"text","value":": Commonwealth Foundation brief on Maryland lessons for Pennsylvania; NC FPA materials on the ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"oSg01CHtJ0"},{"type":"link","url":"/book/cv/policy-briefs","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"policy briefs","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"TNggMX2j2D"}],"urlSource":"../cv/policy-briefs.md","dataUrl":"/book.cv.policy-briefs.json","internal":true,"protocol":"file","key":"RHNpC0ZpCO"},{"type":"text","value":" page.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"PQdjHMbTcw"}],"key":"fSlAWbaxfO"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"LxJsKUaGdh"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"Qj4ZDpOdCk"},{"type":"heading","depth":3,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"lTzCSWLaG6"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"kgmSblOAHE"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The U.S. faces a critical primary care physician shortage, with 17,000–48,000 physicians projected to be needed by 2034. Advanced practice registered nurses (APRNs)—including nurse practitioners and certified nurse midwives—have the education and training to deliver primary care but are often prevented from doing so by state scope-of-practice laws that require physician supervision or collaboration. These regulatory barriers constrain both APRN workforce supply and patient access to primary care, particularly in underserved and rural areas.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"rfn3S1qt3G"}],"key":"EdhUJgkYA4"},{"type":"heading","depth":3,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"nt5eG2sUwu"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"DgKlCBvBa4"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Maryland’s 2015 full practice authority law was associated with significant increases in APRN supply and improvements in health outcomes. In border county comparisons with Pennsylvania (which restricts APRN practice), Maryland had 22.4 more nurse practitioners per 100,000 residents and 0.6 more certified nurse midwives per 100,000 residents. Maryland border counties also showed better health outcomes: 2.8 percentage points fewer adults reporting poor or fair health and 0.354 fewer poor mental health days per month per person, with no significant difference in physician density between states.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"q30mmRhO2W"}],"key":"WclNbFs480"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"IXQxmuFClu"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"tOxbIkzOAA"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":38,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Data sources","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"TXdhcf3Rrt"}],"key":"txWgYZXNXC"},{"type":"text","value":": National Plan and Provider Enumeration System (NPPES) 2016–2021 for provider density; County Health Rankings 2022 for health outcomes","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"tRqq0XbtGW"}],"key":"mVgUfvuhnw"}],"key":"NUctp23G3r"},{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"States compared","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"fc9Ftudfx7"}],"key":"gG6m7Ph09X"},{"type":"text","value":": Maryland (adopted FPA in 2015) vs. Pennsylvania (no FPA for NPs or CNMs)","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"NKxBZyk9AT"}],"key":"ZugyhFDdDs"}],"key":"z7ecOlYKGv"},{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Geographic scale","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"Pm1BV3B2UC"}],"key":"likS8grz6f"},{"type":"text","value":": Full state and border county comparisons","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"GxkounfaMc"}],"key":"oZg8MKbgeF"}],"key":"X2GUxDBiCY"},{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Health outcomes","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"VTs8JquPor"}],"key":"iuOKaReYMn"},{"type":"text","value":": Poor or fair health status, poor mental health days per month, preventable hospital stays for Medicare enrollees","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"nLl9Kj85mH"}],"key":"WQI8pTQG2W"}],"key":"EX12qCpf8c"},{"type":"listItem","spread":true,"position":{"start":{"line":42,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Population","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"fJYHC6WhVM"}],"key":"jKeQAK3B4Y"},{"type":"text","value":": Maryland and Pennsylvania residents, 2016–2021","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"eAfikohySv"}],"key":"Ya8qmK5pDV"}],"key":"Fwj1KMbWEF"}],"key":"UX8LAtck1L"},{"type":"heading","depth":3,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"g6aGZ9m2bZ"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"smuy0Er14h"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Border contiguity-based difference-in-differences analysis comparing geographically similar Maryland and Pennsylvania counties across state lines. Researchers examined provider density data (2016–2021) using NPPES to identify all practicing nurse practitioners and certified nurse midwives per 100,000 residents. Separate cross-sectional analysis examined county-level health outcomes (2022) using regression analysis with year fixed effects and state-level clustered standard errors. No additional covariates were included to avoid collider bias.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"P3oPBKHQzF"}],"key":"HIOEsoxqlB"},{"type":"heading","depth":3,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"gdK3w8Ugnz"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"QYKECX0FoB"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"The analysis lacks pre-2016 baseline data before Maryland’s 2015 FPA adoption, preventing traditional temporal difference-in-differences estimation and precluding causal claims—results are correlational and suggestive rather than definitive. Additionally, not all CNMs and NPs provide primary care; approximately 50% of CNMs and 70% of NPs provide primary care services, so effects may be diluted. Results are specific to the Maryland-Pennsylvania border comparison and may not generalize to other state FPA changes or countries where scope of practice is defined differently. Maryland’s unique all-payer healthcare rate-setting model may also influence results.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"yxTtnCEw3Z"}],"key":"tqGdU56mnr"},{"type":"heading","depth":3,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"wjyHFtj5Z3"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"pMIHY11xro"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/4vw2vcl9v5ckwrmnjloxk/Advanced-Practice-Registered-Nurse-Full-Practice-Authority-Border-Analysis.pdf?rlkey=c11r6bonquwwn2elijdnxjtgb&dl=0","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"qVOTjxE9Zj"}],"urlSource":"https://www.dropbox.com/scl/fi/4vw2vcl9v5ckwrmnjloxk/Advanced-Practice-Registered-Nurse-Full-Practice-Authority-Border-Analysis.pdf?rlkey=c11r6bonquwwn2elijdnxjtgb&dl=0","key":"hJW1TdXkgV"}],"key":"jijyiepHr8"},{"type":"heading","depth":2,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"yMgoNDUOw0"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"qJgjzCNtuJ"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"This border analysis provides compelling evidence that scope-of-practice restrictions materially constrain healthcare workforce supply and patient health. Maryland’s FPA generated a substantial increase in nurse practitioner density relative to Pennsylvania—the gap more than doubled between 2016 and 2020. Crucially, the paper demonstrates not just increased access but actual health improvements in Maryland border counties. This methodological approach—isolating FPA policy effects by comparing geographically similar communities across state boundaries—controls for regional differences and strengthens the argument for policy causality. The findings challenge the justification for restrictive regulations: there were no differences in physician supply between states, suggesting scope-of-practice restrictions don’t enhance physician recruitment but instead limit APRN mobility and patient access. For states considering FPA expansion, the research provides concrete evidence of dual benefits—increased provider supply and improved population health—at minimal regulatory cost.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"r0xCCx2Pmw"}],"key":"cq8rsQpJ1t"}],"key":"lMDUEaNlIn"}],"key":"m2ThaKiqun"},"references":{"cite":{"order":["Bae_2023"],"data":{"Bae_2023":{"label":"Bae_2023","enumerator":"1","doi":"10.1177/15271544231212155","html":"Bae, K., Norris, C., Shakya, S., & Timmons, E. (2023). Advanced Practice Registered Nurse Full Practice Authority, Provider Supply, and Health Outcomes: A Border Analysis. <i>Policy, Politics, &amp; Nursing Practice</i>, <i>25</i>(1), 6–13. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1177/15271544231212155\">10.1177/15271544231212155</a>","url":"https://doi.org/10.1177/15271544231212155"}}}},"footer":{"navigation":{"prev":{"title":"Cultural influences on gender gap in test scores in Afghanistan","short_title":"Gender gap and culture Afghanistan","url":"/book/paper-notes/2024-01-01-afghanistan-gender-gap-tests","group":"Publications"},"next":{"title":"Prescription drug monitoring programs and opioid prescribing","short_title":"PDMP and opioid prescribing","url":"/book/paper-notes/2023-05-01-pdmp-opioid-prescribing","group":"Publications"}}},"domain":"http://localhost:3000"}