"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"VCB1pYpVFw"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"CtVbMO1qSV"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Nepal provides quotas and reservations for disadvantaged groups, but these categories are economically heterogeneous. How can governments design poverty-targeted allocation rules that effectively identify and support those truly below the poverty line?","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ajoAIXxo0t"}],"key":"xSXSNPmcay"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"X6OCMIkrbm"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"o36igDbgfv"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Decision tree models using 14 practical questions can predict household poverty in Nepal with 70-94% accuracy across different scenarios, providing policy makers with implementable tools for quota and reservation allocation that target assistance to the poorest households.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"HHlPdXUUR6"}],"key":"kdTBV08fPD"},{"type":"heading","depth":3,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"T3lSWgciCq"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"MCOBH0pGX4"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"14,907 household observations from Nepal; classification and regression tree (CART) approach modeling 5 different response scenarios.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"m9XDCyCKoE"}],"key":"FYORh8dnaI"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"bGfGefMv2m"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"LIUiYhulOa"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Machine learning (CART) developed simple decision trees based on answerable questions enumerators could verify. Multiple response scenarios tested rule robustness; out-of-sample accuracy measured.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"sH51zOJZHS"}],"key":"XFTZqVxiLg"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"U4811h8uN9"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"Pug0ycgvuu"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Decision rules’ accuracy varies significantly depending on response patterns (70-94%), suggesting real-world performance depends heavily on implementation and response reliability.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"pe9DSvQYLS"}],"key":"fBbfMizO7E"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"mtGOzvlEov"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"zOl0g0E3Cn"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"link","url":"https://www.dropbox.com/scl/fi/bex13j7asy4007n51h3ex/11801.pdf?rlkey=56d65l8c3aw93ehwcw3z98f4c&dl=0","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"XPzjaJPLEo"}],"urlSource":"https://www.dropbox.com/scl/fi/bex13j7asy4007n51h3ex/11801.pdf?rlkey=56d65l8c3aw93ehwcw3z98f4c&dl=0","key":"oPUMS6QHuO"}],"key":"zmMm62iY5A"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"VzCWgzXEt2"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"V618UKpQRV"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Quota and reservation systems aim to reduce inequality, but they often miss the poorest households because program administrators lack reliable identification tools. This paper shows that simple, verifiable questions can accurately target poverty-based benefits. For developing country governments, the practical decision-tree approach is implementable without expensive data collection - a major advantage over statistical matching or means testing that may require documentation many poor households lack. For India, Nepal, and other countries relying on affirmative action via quotas, better targeting improves both program effectiveness and public trust. The finding that accuracy varies across response scenarios also highlights the need for robustness testing when adopting these rules in new settings. By linking the gap between broad categorical quotas and truly poverty-targeted assistance, the paper offers a middle path between equity goals and administrative feasibility.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"QwqECiaIV5"}],"key":"RJqLpeHfQC"}],"key":"vl7UAT3sAv"}],"key":"yYoxvfSHzD"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Electricity consumption and economic growth in Nepal","short_title":"Electricity and growth Nepal","url":"/book/paper-notes/2018-01-01-electricity-consumption-nepal","group":"Publications"},"next":{"title":"Academic positions and teaching","url":"/book/cv/academic-positions-and-teaching","group":"Professional Experience"}}},"domain":"http://localhost:3000"}