{"version":3,"kind":"Article","sha256":"4b0ef5425e7494ca02ea179ed3d19140e731639294ca5412ee7414c206aa9d59","slug":"book.paper-notes.2026-01-01-hospital-closure-ownership-profits","location":"/book/paper-notes/2026-01-01-hospital-closure-ownership-profits.md","dependencies":[],"frontmatter":{"title":"Hospital ownership and profits when a neighbor closes","description":"For-profit hospitals increase charge-to-cost and profit margins after neighboring closures; non-profit and governmental hospitals show minimal financial gains.","short_title":"Hospital closure and profits","tags":["healthcare","institutional","economics"],"date":"2026-01-01","content_includes_title":false,"copyright":"2026","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"2026-01-01-hospital-closure-ownership-profits.md","url":"/build/2026-01-01-hospital--6a2f4a1e5c451ea58f13f5243805febe.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Publication id","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"jw6Ff8crcY"}],"key":"wFm2kob8c2"},{"type":"text","value":": ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"DgzQyT0Bzh"},{"type":"inlineCode","value":"kanimian-2026-hospital-closure-ownership","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"qevUIApoGy"},{"type":"break","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"ejd9OGgzEy"},{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Status","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"JWsRIFulAN"}],"key":"zFMbjFZULq"},{"type":"text","value":": verified","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"y8RwfiTXGQ"}],"key":"gqGGD2k8Km"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Citation","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"KP2fMg247e"}],"key":"w3NayzcMEX"},{"type":"text","value":": Kanimian, S. & Shakya, S. (2026). When a Neighbor Closes: Ownership and Hospital Profits. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"BYoyiXmwu1"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Eastern Economic Journal","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"N4TysXQ0LU"}],"key":"v50umetcs8"},{"type":"text","value":". ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"PZFechFfs9"},{"type":"cite","url":"https://doi.org/10.1057/s41302-026-00335-x","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"DOI","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"GkYrufNHI8"}],"kind":"narrative","label":"Kanimian_2026","identifier":"https://doi.org/10.1057/s41302-026-00335-x","enumerator":"1","key":"bcFh83UPo8"},{"type":"text","value":". ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"H5k25JQ4mR"},{"type":"link","url":"https://www.dropbox.com/scl/fi/izdybn3pgfkd99rbhtvgk/Kanimian_et_al-2026-Eastern_Economic_Journal.pdf?rlkey=ygyw1k05nr4mvn3n068riofai&st=dcq24u4y&dl=0","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"XegQplZERb"}],"urlSource":"https://www.dropbox.com/scl/fi/izdybn3pgfkd99rbhtvgk/Kanimian_et_al-2026-Eastern_Economic_Journal.pdf?rlkey=ygyw1k05nr4mvn3n068riofai&st=dcq24u4y&dl=0","key":"laUROHkXh0"}],"key":"xLZqGlzg0Q"},{"type":"heading","depth":2,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Facts","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Nx7FkVmJvg"}],"identifier":"facts","label":"Facts","html_id":"facts","implicit":true,"key":"E5M0WOJywx"},{"type":"heading","depth":3,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Policy hook","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"yiVd3W28QP"}],"identifier":"policy-hook","label":"Policy hook","html_id":"policy-hook","implicit":true,"key":"NLVmb4qblu"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Hospital closures are increasingly common, particularly in rural and underserved areas. When a hospital closes, patients face longer travel times and shift to remaining facilities. The question is whether nearby hospitals’ financial outcomes change after a neighboring closure and whether the response depends on hospital ownership type (for-profit, non-profit, or governmental).","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ss8joCLSwK"}],"key":"J7pmFpV1UR"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Main finding","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"dzKYbzCNLp"}],"identifier":"main-finding","label":"Main finding","html_id":"main-finding","implicit":true,"key":"Cr40piZG97"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"For-profit hospitals show the largest post-closure increases in Charge-to-cost ratio (1.959, significant at 5% level), though pre-closure trends make this pattern suggestive. The for-profit Net-profit-margin gain of 0.061 (6.1 percentage points, significant at 5% level) is the best-identified result and is comparable to the non-profit gain of 0.063 (6.3 percentage points, significant at 10% level). Governmental hospitals show changes statistically indistinguishable from zero, with a point estimate of -0.138 on net-profit-margin.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"gubqAuJ7Ri"}],"key":"rcr2q9IinM"},{"type":"heading","depth":3,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Data and setting","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"S6PEDMMFo9"}],"identifier":"data-and-setting","label":"Data and setting","html_id":"data-and-setting","implicit":true,"key":"uomCdRe6fC"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Short-term hospitals (average patient stay less than 30 days) from 2011-2022. Data from the National Academy for State Health Policy Hospital Cost Tool, covering over 5000 hospitals nationwide. Sample restricted to hospitals with exactly two neighboring hospitals within 60 miles, comparing those experiencing a neighboring closure (treatment group: 5 non-profits, 2 governmental, 2 for-profits) to those retaining two neighbors throughout (control group).","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"tZIeHuxHaC"}],"key":"j9hg2mXU1o"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Research design (plain language)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"vkYBSbMOLR"}],"identifier":"research-design-plain-language","label":"Research design (plain language)","html_id":"research-design-plain-language","implicit":true,"key":"fXwN7OzrzI"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Difference-in-differences design using hospital and year fixed effects to compare changes in Charge-to-cost and Net-profit-margin for hospitals before and after a neighboring closure. The primary outcome is the average effect across all post-closure years. An event study using Callaway and Sant’Anna methods examines dynamic effects year-by-year and tests for pre-closure trends. Standard errors are clustered at the hospital level.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"gqexI9K9Rq"}],"key":"OhAjYd1vlg"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"One caveat","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"nfkgW5fQEo"}],"identifier":"one-caveat","label":"One caveat","html_id":"one-caveat","implicit":true,"key":"wJeNeqOY2U"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Sample size is small, especially for for-profit and governmental hospitals (2 treated in each category), making ownership-specific estimates suggestive rather than definitive. The Charge-to-cost results for for-profit hospitals show pre-closure trends that weaken a causal interpretation. Cannot disentangle price and quantity responses without patient-level transaction data. Payer-mix differences across ownership types affect outcome levels.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"bKpRmWwT38"}],"key":"pNkD25cft0"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"PDF or DOI","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"Oxk6sCLGaN"}],"identifier":"pdf-or-doi","label":"PDF or DOI","html_id":"pdf-or-doi","implicit":true,"key":"jSxNLmlgyw"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"cite","url":"https://doi.org/10.1057/s41302-026-00335-x","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"DOI: 10.1057/s41302-026-00335-x","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"C5itZtnOZW"}],"kind":"narrative","label":"Kanimian_2026","identifier":"https://doi.org/10.1057/s41302-026-00335-x","enumerator":"1","key":"WL60IQQzVJ"},{"type":"text","value":". ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"mq4j8I6D3X"},{"type":"link","url":"https://www.dropbox.com/scl/fi/izdybn3pgfkd99rbhtvgk/Kanimian_et_al-2026-Eastern_Economic_Journal.pdf?rlkey=ygyw1k05nr4mvn3n068riofai&st=dcq24u4y&dl=0","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Download PDF","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"GFd4Pt98tp"}],"urlSource":"https://www.dropbox.com/scl/fi/izdybn3pgfkd99rbhtvgk/Kanimian_et_al-2026-Eastern_Economic_Journal.pdf?rlkey=ygyw1k05nr4mvn3n068riofai&st=dcq24u4y&dl=0","key":"SaaXGKMAJz"}],"key":"Hj9mDiBS0R"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Why it matters","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"couV8VgHEC"}],"identifier":"why-it-matters","label":"Why it matters","html_id":"why-it-matters","implicit":true,"key":"kHXK8hmCT0"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Hospital closures reallocate patient demand and change local competitive pressure. The results show that hospital responses differ significantly by ownership type. For-profit hospitals appear to use reduced competition as an opportunity to increase markups and profitability, consistent with profit-maximizing behavior. Non-profit hospitals also gain financially but with less precision. Governmental hospitals show minimal or negative financial impacts, suggesting they face different constraints or serve a different patient population. These ownership-specific responses have implications for price monitoring, financial support mechanisms, and policy responses to hospital closures in different market contexts.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"KtY7j81emM"}],"key":"pnfJVGZ4JS"}],"key":"CiQPDMkRzt"}],"key":"abHiDbphSP"},"references":{"cite":{"order":["Kanimian_2026"],"data":{"Kanimian_2026":{"label":"Kanimian_2026","enumerator":"1","doi":"10.1057/s41302-026-00335-x","html":"Kanimian, S., & Shakya, S. (2026). When a Neighbor Closes: Ownership and Hospital Profits. <i>Eastern Economic Journal</i>, <i>52</i>(3), 562–576. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1057/s41302-026-00335-x\">10.1057/s41302-026-00335-x</a>","url":"https://doi.org/10.1057/s41302-026-00335-x"}}}},"footer":{"navigation":{"prev":{"title":"Investigating replicability in the social and behavioral sciences","short_title":"SCORE replicability","url":"/book/paper-notes/2026-01-01-score-replicability-nature","group":"Publications"},"next":{"title":"Covert regime change and ideology","short_title":"Covert regime change","url":"/book/paper-notes/2026-01-01-covert-regime-change-ideology","group":"Publications"}}},"domain":"http://localhost:3000"}